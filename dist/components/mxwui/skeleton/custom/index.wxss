.mx-skeleton-animate{background:linear-gradient(90deg,#e1e5ec 25%,#f4f6f7 37%,#e1e5ec 63%)!important;background-size:400% 100%!important;animation:mx-skeleton-loading 1.4s ease infinite}@keyframes mx-skeleton-loading{0%{background-position:100% 50%}100%{background-position:0 50%}}.mx-skeleton-custom{box-sizing:border-box;display:block;overflow:hidden;border-radius:8rpx;background-color:#e1e5ec}