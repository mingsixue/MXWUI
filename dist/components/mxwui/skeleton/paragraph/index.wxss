.mx-skeleton-animate{background:linear-gradient(90deg,#e1e5ec 25%,#f4f6f7 37%,#e1e5ec 63%)!important;background-size:400% 100%!important;animation:mx-skeleton-loading 1.4s ease infinite}@keyframes mx-skeleton-loading{0%{background-position:100% 50%}100%{background-position:0 50%}}.mx-skeleton-paragraph{box-sizing:border-box;width:100%}.mx-skeleton-paragraph .mx-skeleton-paragraph-row{width:100%;height:30rpx;margin-bottom:24rpx;border-radius:8rpx;background-color:#e1e5ec}.mx-skeleton-paragraph .mx-skeleton-paragraph-row:last-child{margin-bottom:0}.mx-skeleton-paragraph .mx-skeleton-paragraph-row.mx-skeleton-paragraph-row-last{width:60%}