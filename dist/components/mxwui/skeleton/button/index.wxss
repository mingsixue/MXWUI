.mx-skeleton-animate{background:linear-gradient(90deg,#e1e5ec 25%,#f4f6f7 37%,#e1e5ec 63%)!important;background-size:400% 100%!important;animation:mx-skeleton-loading 1.4s ease infinite}@keyframes mx-skeleton-loading{0%{background-position:100% 50%}100%{background-position:0 50%}}.mx-skeleton-button{box-sizing:border-box;display:inline-block;width:120rpx;height:48rpx;border-radius:8rpx;background-color:#e1e5ec;vertical-align:top}.mx-skeleton-button.mx-skeleton-button-small{height:48rpx;width:100rpx}.mx-skeleton-button.mx-skeleton-button-medium{height:64rpx;width:120rpx}.mx-skeleton-button.mx-skeleton-button-large{height:80rpx;width:160rpx}