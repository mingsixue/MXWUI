<view class="pageDemo"><mx-nav title="Mask" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Mask">Mask</desc><desc>统一的蒙层组件，常用于弹窗、引导等场景。</desc></view><wrap><title type="h2">是否显示蒙层</title><desc type="prop" text="visible">visible</desc><mx-mask visible="{{visible}}" bind:mask_tap="handleClick" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisible">查看效果</mx-btn></view></wrap><wrap><title type="h2">设置透明度</title><desc type="prop" text="opacity">opacity</desc><desc type="value" text="默认0.6，范围值：0-1">默认0.6，范围值：0-1</desc><mx-mask visible="{{visibleOpacity}}" opacity="0.2" bind:mask_tap="handleClick" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleOpacity">设置透明度</mx-btn></view></wrap><wrap><title type="h2">层级</title><desc type="prop" text="zIndex">zIndex</desc><desc type="value" text="默认520">默认520</desc></wrap><wrap><title type="h2">关闭事件</title><desc type="prop" text="bind">bind</desc><desc type="value" text="mask_tap">mask_tap</desc><mx-mask visible="{{visibleMask}}" bind:mask_tap="handleClick" /><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleVisibleMask">事件</mx-btn></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view>