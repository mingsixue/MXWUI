<view class="pageDemo"><mx-nav title="步长器" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Stepper">Stepper</desc><desc>由增加按钮、减少按钮和输入框组成，用于在一定范围内输入、调整数字</desc></view><wrap><title type="h2">基本用法</title><div class="cons"><mx-stepper bind:stepper_change="changeValue" /></div></wrap><wrap><title type="h2">默认值</title><desc type="prop" text="value">value</desc><div class="cons"><mx-stepper value="{{1}}" /></div></wrap><wrap><title type="h2">最大值限制</title><desc type="prop" text="max">max</desc><div class="cons"><mx-stepper max="{{9999}}" value="{{10000}}" /></div></wrap><wrap><title type="h2">最小值限制</title><desc type="prop" text="min">min</desc><div class="cons"><mx-stepper min="{{5}}" value="{{1}}" /></div></wrap><wrap><title type="h2">指定步长</title><desc type="prop" text="step">step</desc><div class="cons"><mx-stepper step="{{5}}" /></div></wrap><wrap><title type="h2">是否禁用</title><desc type="prop" text="disabled">disabled</desc><div class="cons"><mx-stepper value="{{1}}" disabled /></div></wrap><wrap><title type="h2">禁用输入框</title><desc type="prop" text="disabledInput">disabledInput</desc><div class="cons"><mx-stepper disabledInput /></div></wrap><wrap><title type="h2">输入框光标颜色</title><desc type="prop" text="cursorColor">cursorColor</desc><div class="cons"><mx-stepper cursorColor="#1677FF" /></div></wrap><wrap><title type="h2">值变更事件</title><desc type="prop" text="bind:stepper_change">bind:stepper_change</desc><div class="cons"><mx-stepper value="{{1}}" bind:stepper_change="changeValue" /></div></wrap><line /><prop-table dataSource="{{propDocs}}" /></view>