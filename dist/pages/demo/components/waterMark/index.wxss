.pageDemo{min-height:100vh;padding-bottom:48rpx;padding-bottom:calc(constant(safe-area-inset-bottom) + 48rpx);padding-bottom:calc(env(safe-area-inset-bottom) + 48rpx);background:#f8f9fa;box-sizing:border-box}.demoIntro{position:relative;padding:32rpx 0 20rpx;margin-bottom:8rpx}.demoIntro::before{content:'';position:absolute;left:0;right:0;top:0;bottom:0;z-index:0;background:radial-gradient(ellipse 80% 90% at 0 0,rgba(202,14,45,.1) 0,transparent 55%),linear-gradient(180deg,#fff 0,#f8f9fa 100%);pointer-events:none}.demoIntro>desc,.demoIntro>title,.demoIntro>view{position:relative;z-index:1}.cons{display:flex;flex-wrap:wrap;align-items:center;margin:8rpx 48rpx 16rpx}.cons .space{display:inline-block;width:24rpx}.pageDemo .cons{display:block;margin:8rpx 48rpx 16rpx;padding:8rpx 0 16rpx}.pageDemo .panel{box-sizing:border-box;min-height:280rpx;padding:32rpx;background:#fff;border-radius:16rpx;border:2rpx solid #e1e5ec}.pageDemo .panelTall{min-height:360rpx}.pageDemo .panelTheme{border-color:rgba(202,14,45,.2);background:rgba(202,14,45,.04)}.pageDemo .tip{min-height:auto;background:#f8f9fa}.pageDemo .panelTitle{font-size:30rpx;font-weight:600;color:#040a23;line-height:1.4}.pageDemo .panelText{margin-top:16rpx;font-size:26rpx;color:#656979;line-height:1.6}