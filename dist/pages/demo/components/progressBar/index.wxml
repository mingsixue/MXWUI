<view class="pageDemo"><mx-nav title="进度条" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="ProgressBar">ProgressBar</desc><desc>用于展示操作或任务的当前进度，支持条形与环形</desc></view><wrap><title type="h2">基本用法</title><desc type="prop" text="percent">percent</desc><view class="cons consGap"><mx-progress-bar percent="{{30}}" /><mx-progress-bar percent="{{50}}" /><mx-progress-bar percent="{{70}}" /></view></wrap><wrap><title type="h2">环形进度条</title><desc type="prop" text="type">type="circle"</desc><view class="cons"><view class="circleRow"><mx-progress-bar type="circle" percent="{{30}}" /><mx-progress-bar type="circle" percent="{{50}}" /><mx-progress-bar type="circle" percent="{{75}}" width="{{120}}" /></view></view></wrap><wrap><title type="h2">语义化状态</title><desc type="prop" text="status">status</desc><view class="cons consGap"><mx-progress-bar percent="{{100}}" status="success" /><mx-progress-bar percent="{{50}}" status="exception" /></view></wrap><wrap><title type="h2">隐藏数值</title><desc type="prop" text="showInfo">showInfo</desc><view class="cons"><mx-progress-bar percent="{{60}}" showInfo="{{false}}" /></view></wrap><wrap><title type="h2">自定义样式</title><desc type="prop" text="strokeWidth">strokeWidth</desc><desc type="prop" text="strokeColor">strokeColor</desc><desc type="prop" text="trailColor">trailColor</desc><view class="cons consGap"><mx-progress-bar percent="{{50}}" strokeWidth="{{12}}" /><mx-progress-bar percent="{{60}}" strokeColor="#1677FF" /><mx-progress-bar percent="{{40}}" strokeColor="#00B578" trailColor="#FFCF9F" /><view class="circleRow"><mx-progress-bar type="circle" percent="{{70}}" strokeWidth="{{6}}" strokeColor="#1677FF" trailColor="#E1E5EC" /><mx-progress-bar type="circle" percent="{{100}}" status="success" width="{{90}}" /></view></view></wrap><wrap><title type="h2">动态进度</title><desc type="prop" text="percent">percent</desc><desc type="value" text="当前：{{dynamicPercent}}%">当前：{{dynamicPercent}}%</desc><view class="cons consGap"><mx-progress-bar percent="{{dynamicPercent}}" /><mx-progress-bar type="circle" percent="{{dynamicPercent}}" /></view><view class="btnRow"><mx-btn width="160rpx" small type="default" bind:btn_tap="handleMinus">减少</mx-btn><mx-btn width="160rpx" small bind:btn_tap="handleAdd">增加</mx-btn><mx-btn width="160rpx" small type="default" bind:btn_tap="handleReset">重置</mx-btn></view></wrap><wrap><title type="h2">关闭动画</title><desc type="prop" text="animation">animation</desc><view class="cons"><mx-progress-bar percent="{{80}}" animation="{{false}}" /></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 