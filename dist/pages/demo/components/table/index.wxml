<view class="pageDemo"><mx-nav title="表格" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Table">Table</desc><desc>展示行列数据，支持固定列、排序、局部滚动与铺满布局</desc></view><wrap><title type="h2">基本使用</title><desc type="prop" text="dataSource">dataSource</desc><desc type="prop" text="columns">columns</desc><desc type="prop" text="bind:table_row_tap">bind:table_row_tap</desc><desc type="prop" text="bind:table_sort">bind:table_sort</desc><view class="cons"><mx-table dataSource="{{dataSource}}" columns="{{columns}}" bind:table_row_tap="handleRowTap" bind:table_sort="handleSort" /></view></wrap><wrap><title type="h2">设置列宽</title><desc type="prop" text="columns[].width">columns[].width</desc><desc>支持数字(rpx)、`120rpx`、`80px`</desc><view class="cons"><mx-table dataSource="{{dataSource}}" columns="{{widthColumns}}" bind:table_row_tap="handleRowTap" /></view></wrap><wrap><title type="h2">列对齐</title><desc type="prop" text="columns[].align">columns[].align</desc><desc>可选 `left`、`center`、`right`，默认 `left`</desc><view class="cons"><mx-table dataSource="{{dataSource}}" columns="{{alignColumns}}" bind:table_row_tap="handleRowTap" bind:table_sort="handleSort" /></view></wrap><wrap><title type="h2">局部滚动</title><desc type="prop" text="scrollHeight">scrollHeight</desc><view class="cons"><mx-table dataSource="{{dataSource}}" columns="{{columns}}" scrollHeight="360rpx" bind:table_row_tap="handleRowTap" /></view></wrap><wrap><title type="h2">铺满展示</title><desc type="prop" text="displayType">displayType = FULL</desc><view class="cons"><mx-table dataSource="{{dataSource}}" columns="{{fullColumns}}" displayType="FULL" bind:table_row_tap="handleRowTap" /></view></wrap><wrap><title type="h2">超出换行省略</title><desc type="prop" text="ellipsisRow">columns[].ellipsisRow</desc><view class="cons"><mx-table dataSource="{{ellipsisData}}" columns="{{ellipsisColumns}}" displayType="FULL" /></view></wrap><wrap><title type="h2">空数据</title><desc type="prop" text="emptyIcon">emptyIcon</desc><desc type="prop" text="emptyText">emptyText</desc><view class="cons"><mx-table dataSource="{{emptyData}}" columns="{{fullColumns}}" displayType="FULL" /></view></wrap><wrap><title type="h2">自定义空状态图标</title><desc type="prop" text="emptyIcon">emptyIcon</desc><desc type="prop" text="emptyIconSize">emptyIconSize</desc><desc type="prop" text="emptyText">emptyText</desc><view class="cons"><mx-table dataSource="{{emptyData}}" columns="{{fullColumns}}" displayType="FULL" emptyIcon="order" emptyIconSize="{{100}}" emptyText="暂无订单" /></view></wrap><wrap><title type="h2">自定义空状态插槽</title><desc>默认插槽；需将 emptyIcon、emptyText 置空</desc><view class="cons"><mx-table dataSource="{{emptyData}}" columns="{{fullColumns}}" displayType="FULL" emptyIcon="" emptyText="" ><view class="emptyCustom">暂无相关记录</view></mx-table></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 