<view class="pageDemo"><mx-nav title="确认弹窗" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Confirm">Confirm</desc><desc>适用于需要用户操作确认的场景，只能通过按钮来关闭，基于基础弹窗组件的封装。</desc></view><wrap><title type="h2">是否显示弹窗</title><desc type="prop" text="visible">visible</desc><mx-confirm visible="{{false}}" /></wrap><wrap><title type="h2">标题</title><desc type="prop" text="title">title</desc><desc type="value" text="默认“系统消息”">默认“系统消息”</desc><mx-confirm visible="{{visibleTitle}}" title="自定义标题" bind:confirm="handleConfirm" bind:cancel="handleCancel" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleTitle">自定义标题</mx-btn></view></wrap><wrap><title type="h2">内容</title><desc type="prop" text="content">content</desc><mx-confirm visible="{{visibleContent}}" content="这是自定义内容，高度可根据内容多少自适应展示这是自定义内容这是自定义内容这是自定义内容这是自定义内容" bind:confirm="handleConfirm" bind:cancel="handleCancel" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleContent">自定义内容</mx-btn></view></wrap><wrap><title type="h2">确定按钮</title><desc type="prop" text="confirmBtnText">confirmBtnText</desc><desc type="value" text="默认“确定”">默认“确定”</desc><desc type="prop" text="confirmBtnColor">confirmBtnColor</desc><mx-confirm visible="{{visibleConfirm}}" content="这是自定义内容，高度可根据内容多少自适应展示这是自定义内容这是自定义内容这是自定义内容这是自定义内容" confirmBtnText="{{confirmBtnText}}" confirmBtnColor="{{confirmBtnColor}}" bind:confirm="handleConfirm" bind:cancel="handleCancel" /><view class="cons"><mx-btn width="200rpx" small bind:btn_tap="handleConfirm2">修改按钮文案</mx-btn><view class="space"></view><mx-btn width="200rpx" small bind:btn_tap="handleConfirm3">修改按钮颜色</mx-btn></view></wrap><wrap><title type="h2">取消按钮</title><desc type="prop" text="cancelBtnText">cancelBtnText</desc><desc type="prop" text="cancelBtnColor">cancelBtnColor</desc><mx-confirm visible="{{visibleCancel}}" content="这是自定义内容，高度可根据内容多少自适应展示这是自定义内容这是自定义内容这是自定义内容这是自定义内容" cancelBtnText="{{cancelBtnText}}" cancelBtnColor="{{cancelBtnColor}}