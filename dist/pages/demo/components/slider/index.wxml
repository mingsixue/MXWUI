<view class="pageDemo"><mx-nav title="滑块" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Slider">Slider</desc><desc>可以通过移动滑块在某一范围内取值，支持单滑块与双滑块</desc></view><wrap><title type="h2">基本用法</title><desc type="prop" text="defaultValue">defaultValue</desc><view class="cons"><mx-slider defaultValue="{{80}}" bind:slider_change="onChange" bind:slider_afterchange="onAfterChange" /></view></wrap><wrap><title type="h2">禁用状态</title><desc type="prop" text="disabled">disabled</desc><view class="cons"><mx-slider defaultValue="{{80}}" disabled /></view></wrap><wrap><title type="h2">双滑块模式</title><desc type="prop" text="range">range</desc><view class="cons"><mx-slider range defaultValue="{{rangeValue}}" bind:slider_change="onRangeChange" /></view><desc type="value" text="当前：{{rangeText}}">当前：{{rangeText}}</desc></wrap><wrap><title type="h2">节点和刻度</title><desc type="prop" text="showTicks">showTicks</desc><desc type="prop" text="showNumber">showNumber</desc><desc type="prop" text="step">step</desc><view class="cons"><mx-slider defaultValue="{{80}}" step="{{20}}" showTicks showNumber /></view></wrap><wrap><title type="h2">悬浮提示</title><desc type="prop" text="showTooltip">showTooltip</desc><view class="cons"><mx-slider defaultValue="{{80}}" showTooltip /></view></wrap><wrap><title type="h2">受控模式</title><desc type="prop" text="value">value</desc><desc type="value" text="当前：{{value}}">当前：{{value}}</desc><view class="cons"><mx-slider min="{{0}}" max="{{100}}" value="{{value}}" bind:slider_change="onControlledChange" /></view><view class="stepperRow"><mx-stepper min="{{0}}" max="{{100}}" value="{{value}}" bind:stepper_change="onStepperChange" /></view></wrap><wrap><title type="h2">自定义颜色</title><desc type="prop" text="activeColor">activeColor</desc><desc type="prop" text="inactiveColor">inactiveColor</desc><view class="cons"><mx-slider defaultValue="{{60}}" step="{{20}}" showTicks showNumber showTooltip activeColor="#1677FF" inactiveColor="#E1E5EC" activeLineStyle="background-color: #1677FF;" activeDotStyle="background-color: #1677FF;" /></view></wrap><wrap><title type="h2">事件</title><desc type="prop" text="bind:slider_change">bind:slider_change</desc><desc type="prop" text="bind:slider_afterchange">bind:slider_afterchange</desc><view class="cons"><mx-slider defaultValue="{{30}}" showTooltip bind:slider_change="onChange" bind:slider_afterchange="onAfterChange" /></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 