<view class="pageDemo"><mx-nav title="开关列表" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="ListSwitch">ListSwitch</desc><desc>常用于个人中心、设置等有开关列表的场景。</desc></view><wrap><title type="h2">基本用法</title><mx-list-switch label="标签文本" bind:list_switch_change="handleSwitchChange" /></wrap><wrap><title type="h2">标签文本</title><desc type="prop" text="label">label</desc><desc type="prop" text="labelColor">labelColor</desc><desc type="prop" text="labelAlign">labelAlign</desc><desc type="value" text="对齐方式，left / center / right">对齐方式，left / center / right</desc><mx-list-switch label="标签文本" /><mx-list-switch label="标签文本" labelColor="#CA0E2D" /><mx-list-switch label="标签文本：" leftWidth="280" labelAlign="center" /><mx-list-switch label="标签文本：" leftWidth="280" labelAlign="right" /></wrap><wrap><title type="h2">左侧自定义宽度</title><desc type="prop" text="leftWidth">leftWidth</desc><mx-list-switch label="左侧自定义宽度" leftWidth="280" /></wrap><wrap><title type="h2">是否必填</title><desc type="prop" text="required">required</desc><desc type="prop" text="requiredPosition">requiredPosition</desc><mx-list-switch label="标签文本" required /><mx-list-switch label="标签文本" required requiredPosition="left" /></wrap><wrap><title type="h2">标签前图标</title><desc type="prop" text="firstIcon">firstIcon</desc><mx-list-switch label="标签前图标" firstIcon="{{firstIcon}}" /><mx-list-switch label="标签前图标自定义" firstIcon="{{firstIcon2}}" /></wrap><wrap><title type="h2">标签后图标</title><desc type="prop" text="lastIcon">lastIcon</desc><mx-list-switch label="标签后图标" lastIcon="{{lastIcon}}" /><mx-list-switch label="标签后图标自定义" lastIcon="{{lastIcon2}}" /></wrap><wrap><title type="h2">Switch选中</title><desc type="prop" text="checked">checked</desc><mx-list-switch label="选中" checked="{{true}}" /></wrap><wrap><title type="h2">Switch禁用</title><desc type="prop" text="disabled">disabled</desc><mx-list-switch label="禁用" disabled="{{true}}" /></wrap><wrap><title type="h2">Switch颜色</title><desc type="prop" text="switchColor">switchColor</desc><mx-list-switch label="自定义颜色" checked switchColor="#CA0E2D" /></wrap><wrap><title type="h2">描述</title><desc type="prop" text="desc">desc</desc><desc type="prop" text="descColor">descColor</desc><mx-list-switch label="标签文本" desc="描述内容描述内容描述内容" arrows /><mx-list-switch label="标签文本" desc="描述内容描述内容描述内容" descColor="#CA0E2D" arrows /></wrap><wrap><title type="h2">是否显示分隔线</title><desc type="prop" text="showLine">showLine</desc><mx-list-switch label="标签文本" showLine="{{false}}" /></wrap><wrap><title type="h2">事件</title><desc type="prop" text="bind:list_switch_firstIcon">bind:list_switch_firstIcon</desc><desc type="value" text="标签前图标点击">标签前图标点击</desc><desc type="prop" text="bind:list_switch_lastIcon">bind:list_switch_lastIcon</desc><desc type="value" text="标签后图标点击">标签后图标点击</desc><desc type="prop" text="bind:list_switch_change">bind:list_switch_change</desc><desc type="value" text="Switch开关事件">Switch开关事件</desc><mx-list-switch label="事件" firstIcon="{{firstIcon}}" lastIcon="{{lastIcon}}" arrows bind:list_switch_firstIcon="handleFirstIcon" bind:list_switch_lastIcon="handleLastIcon" bind:list_switch_change="handleSwitchChange" /></wrap><prop-table dataSource="{{propDocs}}" /></view>