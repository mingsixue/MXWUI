<view class="pageDemo"><mx-nav title="宫格" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Grid">Grid</desc><desc>用于业务中多个子功能的导航，相比列表具有更高屏效</desc></view><wrap><title type="h2">基本用法</title><desc type="prop" text="columns">columns="{{5}}"</desc><view class="cons"><mx-grid items="{{items5}}" columns="{{5}}" bind:grid_tap="handleTap" /></view></wrap><wrap><title type="h2">3 列带描述</title><desc type="prop" text="columns">columns="{{3}}"</desc><desc type="prop" text="description">items[].description</desc><view class="cons"><mx-grid items="{{items3}}" columns="{{3}}" bind:grid_tap="handleTap" /></view></wrap><wrap><title type="h2">带分割线</title><desc type="prop" text="showDivider">showDivider</desc><view class="cons"><mx-grid items="{{items4}}" columns="{{4}}" showDivider bind:grid_tap="handleTap" /></view></wrap><wrap><title type="h2">自定义图片</title><desc type="prop" text="iconUrl">items[].iconUrl</desc><desc type="prop" text="icon">items[].icon 传图片地址</desc><view class="cons"><mx-grid items="{{itemsImage}}" columns="{{5}}" bind:grid_tap="handleTap" /></view></wrap><wrap><title type="h2">横向布局</title><desc type="prop" text="gridItemLayout">gridItemLayout="horizontal"</desc><view class="cons"><mx-grid items="{{items3}}" columns="{{3}}" gridItemLayout="horizontal" bind:grid_tap="handleTap" /></view></wrap><wrap><title type="h2">圆形图标</title><desc type="prop" text="iconStyle">iconStyle="circle"</desc><view class="cons"><mx-grid items="{{itemsCircle}}" columns="{{5}}" iconStyle="circle" bind:grid_tap="handleTap" /></view></wrap><wrap><title type="h2">自定义图标尺寸与颜色</title><desc type="prop" text="iconSize">iconSize</desc><desc type="prop" text="iconColor">items[].iconColor</desc><view class="cons"><mx-grid items="{{itemsCustom}}" columns="{{5}}" iconSize="{{72}}" bind:grid_tap="handleTap" /></view></wrap><wrap><title type="h2">横向滑动</title><desc type="prop" text="mode">mode="scroll"</desc><view class="cons"><mx-grid items="{{itemsScroll}}" mode="scroll" bind:grid_tap="handleTap" /></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 