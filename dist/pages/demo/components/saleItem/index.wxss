.pageDemo{min-height:100vh;padding-bottom:48rpx;padding-bottom:calc(constant(safe-area-inset-bottom) + 48rpx);padding-bottom:calc(env(safe-area-inset-bottom) + 48rpx);background:#f8f9fa;box-sizing:border-box}.demoIntro{position:relative;padding:32rpx 0 20rpx;margin-bottom:8rpx}.demoIntro::before{content:'';position:absolute;left:0;right:0;top:0;bottom:0;z-index:0;background:radial-gradient(ellipse 80% 90% at 0 0,rgba(202,14,45,.1) 0,transparent 55%),linear-gradient(180deg,#fff 0,#f8f9fa 100%);pointer-events:none}.demoIntro>desc,.demoIntro>title,.demoIntro>view{position:relative;z-index:1}.cons{display:flex;flex-wrap:wrap;align-items:center;margin:8rpx 48rpx 16rpx}.cons .space{display:inline-block;width:24rpx}.pageDemo .cons{display:flex;justify-content:space-between;align-items:stretch;flex-wrap:wrap;margin:8rpx 24rpx 16rpx;box-sizing:border-box}.pageDemo .cons .space{display:inline-block;width:18rpx}.pageDemo .cons .item{margin-bottom:18rpx}.pageDemo .cons .mask{width:342rpx;height:342rpx;background:rgba(0,0,0,.6)}.pageDemo .cons .mask .img{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:96rpx;height:96rpx;background:url(https://cdn.mingsixue.com/xcx/MXWUI/temp/sale.png) no-repeat;background-size:cover}.pageDemo .cons .btn{display:flex;align-items:center;justify-content:center;margin:0 auto;width:300rpx;height:120rpx;background:#1677ff;color:#fff;font-size:32rpx}