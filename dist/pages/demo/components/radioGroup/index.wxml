<view class="pageDemo"><mx-nav title="单选框组" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="RadioGroup">RadioGroup</desc><desc>用于互斥选项之间的选择，一般用于在一组选项中选择一个值。</desc></view><wrap><title type="h2">基础用法</title><mx-radio-group options="{{options}}" bind:radio_group_change="handleChange" /><line /><mx-radio-group options="{{options2}}" bind:radio_group_change="handleChange" /></wrap><wrap><title type="h2">数据项</title><desc type="prop" text="options">options</desc><desc type="prop" text="options[x].text">options[x].text</desc><desc type="prop" text="options[x].value">options[x].value</desc><desc type="prop" text="options[x].checked：true / false">options[x].checked：true / false</desc><desc type="prop" text="options[x].disabled：true / false">options[x].disabled：true / false</desc></wrap><wrap><title type="h2">样式类型</title><desc type="prop" text="styleType">styleType</desc><desc type="value" text="normal、horizontal、vertical、web">normal、horizontal、vertical、web</desc></wrap><wrap><title type="h2">单选框位置</title><desc type="prop" text="radioPosition">radioPosition</desc><desc type="value" text="after / before">after / before</desc><mx-radio-group radioPosition="after" options="{{options}}" /><line /><mx-radio-group radioPosition="before" options="{{options}}" /></wrap><wrap><title type="h2">单选框颜色</title><desc type="prop" text="radioColor">radioColor</desc><desc type="value" text="未选中颜色">未选中颜色</desc><desc type="prop" text="radioSelectColor">radioSelectColor</desc><desc type="value" text="选中颜色">选中颜色</desc><mx-radio-group radioColor="#000" radioSelectColor="#1677FF" options="{{options}}" /></wrap><wrap><title type="h2">单选框大小</title><desc type="prop" text="radioSize">radioSize</desc><desc type="value" text="默认 48">默认 48</desc><mx-radio-group radioSize="32" options="{{options}}" /></wrap><wrap><title type="h2">描述或错误文案</title><desc type="prop" text="desc">desc</desc><desc type="prop" text="descColor">descColor</desc><mx-radio-group options="{{options}}" desc="请先选择类型" descColor="#CA0E2D" bind:radio_group_change="handleChange" /></wrap><wrap><title type="h2">是否显示分隔线</title><desc type="prop" text="showLine">showLine</desc><mx-radio-group options="{{options}}" showLine="{{true}}" bind:radio_group_change="handleChange" /></wrap><wrap><title type="h2">标签文案</title><desc type="prop" text="label">label</desc><desc type="prop" text="labelColor">labelColor</desc><desc type="prop" text="labelAlign">labelAlign</desc><desc type="value" text="对齐方式，left / center / right">对齐方式，left / center / right</desc><mx-radio-group styleType="horizontal" label="标签文案" options="{{options3}}" /><line /><mx-radio-group styleType="horizontal" label="标签文案" options="{{options3}}" labelColor="#1677FF" /><line /><mx-radio-group styleType="horizontal" label="居中" labelAlign="center" options="{{options3}}" /><line /><mx-radio-group styleType="horizontal" label="右对齐" labelAlign="right" options="{{options3}}" /></wrap><wrap><title type="h2">左侧自定义宽度，不带单位</title><desc type="prop" text="leftWidth">leftWidth</desc><mx-radio-group styleType="horizontal" label="左侧自定义宽度" leftWidth="260" options="{{options4}}" /></wrap><wrap><title type="h2">是否显示必填星号</title><desc type="prop" text="required">required</desc><desc type="prop" text="requiredPosition">requiredPosition</desc><desc type="value" text="left、right">left、right</desc><mx-radio-group styleType="horizontal" label="标签文案" required options="{{options4}}" /><line /><mx-radio-group styleType="horizontal" label="标签文案" required requiredPosition="left" options="{{options4}}" /></wrap><wrap><title type="h2">标签前图标</title><desc type="prop" text="firstIcon">firstIcon</desc><mx-radio-group styleType="horizontal" label="标签文本" firstIcon="{{firstIcon}}" options="{{options4}}"  bind:radio_group_firstIcon="handleFirstIcon" /><line /><mx-radio-group styleType="horizontal" label="标签文本" firstIcon="{{firstIcon2}}" options="{{options4}}"  bind:radio_group_firstIcon="handleFirstIcon" /></wrap><wrap><title type="h2">标签后图标</title><desc type="prop" text="lastIcon">lastIcon</desc><mx-radio-group styleType="horizontal" label="标签文本" lastIcon="{{lastIcon}}" options="{{options4}}"  bind:radio_group_lastIcon="handleLastIcon" /><line /><mx-radio-group styleType="horizontal" label="标签文本" lastIcon="{{lastIcon2}}" options="{{options4}}" bind:radio_group_lastIcon="handleLastIcon" /></wrap><wrap><title type="h2">背景色</title><desc type="prop" text="bgColor">bgColor</desc><mx-radio-group styleType="horizontal" label="标签文本" options="{{options3}}" bgColor="#f2f2f2" /><line /></wrap><wrap><title type="h2">是否横向布局</title><desc type="prop" text="horizontal">horizontal</desc></wrap><wrap><title type="h2">样式一：normal</title><mx-radio-group styleType="normal" options="{{options}}" showLine bind:radio_group_change="handleChange" /><mx-radio-group styleType="normal" options="{{options}}" showLine radioPosition="after" bind:radio_group_change="handleChange" /><mx-radio-group styleType="normal" options="{{options}}" showLine radioColor="#1677FF" radioSelectColor="#1677FF" bind:radio_group_change="handleChange" /><mx-radio-group styleType="normal" options="{{options}}" showLine desc="这是描述内容哦" bind:radio_group_change="handleChange" /><mx-radio-group styleType="normal" options="{{options}}" desc="这是错误提示信息" descColor="#f00" showLine="{{false}}" bind:radio_group_change="handleChange" /></wrap><wrap><title type="h2">样式二：horizontal</title><mx-radio-group styleType="horizontal" options="{{options3}}" label="标签文本" showLine bind:radio_group_change="handleChange" /><mx-radio-group styleType="horizontal" options="{{options3}}" label="标签文本" labelColor="#1677FF" showLine bind:radio_group_change="handleChange" /><mx-radio-group styleType="horizontal" options="{{options3}}" label="标签文本" showLine radioPosition="after" bind:radio_group_change="handleChange" /><mx-radio-group styleType="horizontal" options="{{options3}}" label="标签文本" showLine radioColor="#1677FF" radioSelectColor="#1677FF" bind:radio_group_change="handleChange" /><mx-radio-group styleType="horizontal" options="{{options4}}" label="标签文本" required showLine bind:radio_group_change="handleChange" /><mx-radio-group styleType="horizontal" options="{{options4}}" label="标签文本" required requiredPosition="left" showLine bind:radio_group_change="handleChange" /><mx-radio-group styleType="horizontal" options="{{options4}}" label="自定义图标" firstIcon="{{firstIcon}}" showLine bind:radio_group_change="handleChange" bind:radio_group_firstIcon="handleFirstIcon" /><mx-radio-group styleType="horizontal" options="{{options4}}" label="自定义图片" firstIcon="{{firstIcon2}}" showLine bind:radio_group_change="handleChange" bind:radio_group_firstIcon="handleFirstIcon" /><mx-radio-group styleType="horizontal" options="{{options4}}" label="自定义图标" lastIcon="{{lastIcon}}" showLine bind:radio_group_change="handleChange" bind:radio_group_lastIcon="handleLastIcon" /><mx-radio-group styleType="horizontal" options="{{options4}}" label="自定义图片" lastIcon="{{lastIcon2}}" showLine bind:radio_group_change="handleChange" bind:radio_group_lastIcon="handleLastIcon" /><mx-radio-group styleType="horizontal" options="{{options4}}" label="自定义左侧宽度" leftWidth="280" showLine bind:radio_group_change="handleChange" /><mx-radio-group styleType="horizontal" options="{{options3}}" label="标签文本" showLine desc="这是描述内容哦" bind:radio_group_change="handleChange" /><mx-radio-group styleType="horizontal" options="{{options3}}" label="标签文本" desc="这是错误提示信息" descColor="#f00" showLine="{{false}}" bind:radio_group_change="handleChange" /></wrap><wrap><title type="h2">样式三：vertical</title><mx-radio-group styleType="vertical" options="{{options3}}" label="标签文本" bind:radio_group_change="handleChange" /><mx-radio-group styleType="vertical" options="{{options3}}" label="自定义标签文本颜色" labelColor="#1677FF" bind:radio_group_change="handleChange" /><mx-radio-group styleType="vertical" options="{{options3}}" label="单选框在右侧" radioPosition="after" bind:radio_group_change="handleChange" /><mx-radio-group styleType="vertical"