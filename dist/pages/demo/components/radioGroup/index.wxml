e="web" options="{{options4}}" label="自定义单选框颜色" radioColor="#1677FF" radioSelectColor="#1677FF" bind:radio_group_change="handleChange" /><mx-radio-group styleType="web" options="{{options4}}" label="必填星号在右边" required bind:radio_group_change="handleChange" /><mx-radio-group styleType="web" options="{{options4}}" label="必填星号在左边" required requiredPosition="left" bind:radio_group_change="handleChange" /><mx-radio-group styleType="web" options="{{options4}}" label="自定义图标" firstIcon="{{firstIcon}}" bind:radio_group_change="handleChange" bind:radio_group_firstIcon="handleFirstIcon" /><mx-radio-group styleType="web" options="{{options4}}" label="自定义图片" firstIcon="{{firstIcon2}}" bind:radio_group_change="handleChange" bind:radio_group_firstIcon="handleFirstIcon" /><mx-radio-group styleType="web" options="{{options4}}" label="自定义图标" lastIcon="{{lastIcon}}" bind:radio_group_change="handleChange" bind:radio_group_lastIcon="handleLastIcon" /><mx-radio-group styleType="web" options="{{options4}}" label="自定义图片" lastIcon="{{lastIcon2}}" bind:radio_group_change="handleChange" bind:radio_group_lastIcon="handleLastIcon" /><mx-radio-group styleType="web" options="{{options4}}" label="自定义背景色" bgColor="#f2f2f2" bind:radio_group_change="handleChange" /><mx-radio-group styleType="web" options="{{options4}}" label="标签文本" desc="这是描述内容哦" bind:radio_group_change="handleChange" /><mx-radio-group styleType="web" options="{{options4}}" label="标签文本" desc="这是错误提示信息" descColor="#f00" bind:radio_group_change="handleChange" /><mx-radio-group styleType="web" options="{{options4}}" label="横向布局" horizontal="{{true}}" bind:radio_group_change="handleChange" /></wrap><line /><prop-table dataSource="{{propDocs}}" /></view>