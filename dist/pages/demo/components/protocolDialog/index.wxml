<view class="pageDemo"><mx-nav title="弹窗协议" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="ProtocolDialog">ProtocolDialog</desc><desc>适用于用户协议、隐私政策等需要确认同意的场景，支持强制阅读倒计时。</desc></view><wrap><title type="h2">基础用法</title><mx-protocol-dialog visible="{{visible}}" title="用户协议" content="{{protocolContent}}" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_cancel="handleCancel" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisible">查看样式</mx-btn></view></wrap><wrap><title type="h2">标题</title><desc type="prop" text="title">title</desc><desc type="prop" text="titleColor">titleColor</desc><mx-protocol-dialog visible="{{visibleTitle}}" title="服务协议" titleColor="{{titleColor}}" content="{{protocolContent}}" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_cancel="handleCancel" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleTitle">自定义标题</mx-btn><view class="space"></view><mx-btn width="180rpx" small bind:btn_tap="handleTitleColor">标题文本色</mx-btn></view></wrap><wrap><title type="h2">是否显示标题</title><desc type="prop" text="showTitle">showTitle</desc><mx-protocol-dialog visible="{{visibleShowTitle}}" showTitle="{{false}}" title="用户协议" content="{{protocolContent}}" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_cancel="handleCancel" /><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleShowTitle">隐藏标题</mx-btn></view></wrap><wrap><title type="h2">内容</title><desc type="prop" text="content">content</desc><desc type="prop" text="contentColor">contentColor</desc><mx-protocol-dialog visible="{{visibleContent}}" content="{{protocolContent}}" contentColor="{{contentColor}}" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_cancel="handleCancel" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleContent">设置内容</mx-btn><view class="space"></view><mx-btn width="180rpx" small bind:btn_tap="handleContentColor">内容文本色</mx-btn></view></wrap><wrap><title type="h2">自定义内容</title><desc>使用 slot 方式</desc><mx-protocol-dialog visible="{{visibleSlot}}" title="自定义内容" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_cancel="handleCancel" ><view class="customContent"><view class="h2">自定义协议内容</view><view>可通过插槽完全自定义协议展示样式与结构。</view></view></mx-protocol-dialog><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleSlot">自定义内容</mx-btn></view></wrap><wrap><title type="h2">确认按钮</title><desc type="prop" text="confirmBtnText">confirmBtnText</desc><desc type="prop" text="confirmBtnColor">confirmBtnColor</desc><mx-protocol-dialog visible="{{visibleConfirm}}" content="{{protocolContent}}" confirmBtnText="{{confirmBtnText}}" confirmBtnColor="{{confirmBtnColor}}" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_cancel="handleCancel" /><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleConfirmText">修改文案</mx-btn><view class="space"></view><mx-btn width="180rpx" small bind:btn_tap="handleConfirmColor">修改颜色</mx-btn></view></wrap><wrap><title type="h2">取消按钮</title><desc type="prop" text="cancelBtn">cancelBtn</desc><desc type="prop" text="cancelBtnText">cancelBtnText</desc><desc type="prop" text="cancelBtnColor">cancelBtnColor</desc><mx-protocol-dialog visible="{{visibleCancel}}" content="{{protocolContent}}" cancelBtn="{{cancelBtn}}" cancelBtnText="{{cancelBtnText}}" cancelBtnColor="{{cancelBtnColor}}" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_cancel="handleCancel" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleCancelShow">显示取消</mx-btn><view class="space"></view><mx-btn width="160rpx" small bind:btn_tap="handleCancelHide">隐藏取消</mx-btn><view class="space"></view><mx-btn width="160rpx" small bind:btn_tap="handleCancelText">修改文案</mx-btn><view class="space"></view><mx-btn width="160rpx" small bind:btn_tap="handleCancelColor">修改颜色</mx-btn></view></wrap><wrap><title type="h2">强制阅读</title><desc type="prop" text="forceRead">forceRead</desc><desc type="prop" text="forceReadType">forceReadType</desc><desc type="prop" text="readSeconds">readSeconds</desc><desc>time：倒计时结束后可点；scroll：滑至内容底部后可点</desc><mx-protocol-dialog visible="{{visibleForceRead}}" title="隐私政策" content="{{protocolContent}}" forceRead readSeconds="{{5}}" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_cancel="handleCancel" bind:protocol_dialog_read_finish="handleReadFinish" /><mx-protocol-dialog visible="{{visibleForceRead2}}" title="用户协议" content="{{protocolContent}}" forceRead readSeconds="{{3}}" confirmBtnText="我已阅读" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_cancel="handleCancel" bind:protocol_dialog_read_finish="handleReadFinish" /><mx-protocol-dialog visible="{{visibleForceReadSingle}}" title="用户协议" content="{{protocolContent}}" forceRead readSeconds="{{5}}" cancelBtn="{{false}}" confirmBtnText="同意" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_read_finish="handleReadFinish" /><mx-protocol-dialog visible="{{visibleForceReadScroll}}" title="用户协议" content="{{protocolContent}}" forceRead forceReadType="scroll" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_cancel="handleCancel" bind:protocol_dialog_read_finish="handleReadFinish" /><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleForceRead">强制阅读 5s</mx-btn><view class="space"></view><mx-btn width="180rpx" small bind:btn_tap="handleForceRead2">强制阅读 3s</mx-btn><view class="space"></view><mx-btn width="220rpx" small bind:btn_tap="handleForceReadSingle">单按钮强制阅读</mx-btn><view class="space"></view><mx-btn width="180rpx" small bind:btn_tap="handleForceReadScroll">滑动阅读</mx-btn></view></wrap><wrap><title type="h2">事件</title><desc type="prop" text="bind:protocol_dialog_confirm">bind:protocol_dialog_confirm</desc><desc type="value" text="确认按钮点击">确认按钮点击</desc><desc type="prop" text="bind:protocol_dialog_cancel">bind:protocol_dialog_cancel</desc><desc type="value" text="取消按钮点击">取消按钮点击</desc><desc type="prop" text="bind:protocol_dialog_close">bind:protocol_dialog_close</desc><desc type="value" text="弹窗关闭">弹窗关闭</desc><desc type="prop" text="bind:protocol_dialog_read_finish">bind:protocol_dialog_read_finish</desc><desc type="value" text="强制阅读完成">强制阅读完成</desc><mx-protocol-dialog visible="{{visibleHandle}}" content="{{protocolContent}}" forceRead readSeconds="{{3}}" bind:protocol_dialog_confirm="handleConfirm" bind:protocol_dialog_cancel="handleCancel" bind:protocol_dialog_close="handleClose" bind:protocol_dialog_read_finish="handleReadFinish" /><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleHandle">事件</mx-btn></view></wrap><prop-table dataSource="{{propDocs}}" /></view> 