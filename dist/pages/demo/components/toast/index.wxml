<view class="pageDemo"><mx-nav title="轻提示" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Toast">Toast</desc><desc>对操作结果的轻量级反馈，无需用户操作即可自行消失。最长文案不超过 2 行，最多显示 24 个字符，过长会被截断。</desc></view><wrap><title type="h2">基础用法</title><desc type="prop" text="content">content</desc><desc type="prop" text="visible">visible</desc><mx-toast visible="{{visibleBasic}}" content="{{content}}" time="{{time}}" textType="{{textType}}" bind:toast_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleBasic">纯文本</mx-btn></view></wrap><wrap><title type="h2">图标类型</title><desc type="prop" text="type">type</desc><desc type="value" text="success / error / warning / loading">success / error / warning / loading</desc><mx-toast visible="{{visibleSuccess}}" content="{{content}}" type="success" time="{{time}}" bind:toast_close="handleClose" /><mx-toast visible="{{visibleError}}" content="{{content}}" type="error" time="{{time}}" bind:toast_close="handleClose" /><mx-toast visible="{{visibleWarning}}" content="{{content}}" type="warning" time="{{time}}" bind:toast_close="handleClose" /><mx-toast visible="{{visibleLoading}}" content="{{content}}" type="loading" time="{{time}}" showMask="{{showMask}}" maskCloseable="{{maskCloseable}}" bind:toast_close="handleClose" /><view class="cons"><mx-btn width="140rpx" small bind:btn_tap="handleSuccess">成功</mx-btn><view class="space"></view><mx-btn width="140rpx" small bind:btn_tap="handleError">失败</mx-btn><view class="space"></view><mx-btn width="140rpx" small bind:btn_tap="handleWarning">警告</mx-btn><view class="space"></view><mx-btn width="140rpx" small bind:btn_tap="handleLoading">加载</mx-btn></view></wrap><wrap><title type="h2">自定义图标</title><desc type="prop" text="icon">icon</desc><desc>使用 Icon 组件的 name，优先级高于 image / type</desc><mx-toast visible="{{visibleIcon}}" content="{{content}}" icon="{{icon}}" time="{{time}}" bind:toast_close="handleClose" /><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleIcon">自定义图标</mx-btn></view></wrap><wrap><title type="h2">自定义图片</title><desc type="prop" text="image">image</desc><mx-toast visible="{{visibleImage}}" content="{{content}}" image="{{image}}" time="{{time}}" bind:toast_close="handleClose" /><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleImage">自定义图片</mx-btn></view></wrap><wrap><title type="h2">持续时间</title><desc type="prop" text="time">time</desc><desc type="value" text="单位毫秒，默认 2000，为 0 不自动关闭">单位毫秒，默认 2000，为 0 不自动关闭</desc><mx-toast visible="{{visibleTime}}" content="{{content}}" time="{{time}}" bind:toast_close="handleClose" /><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleTime">3 秒关闭</mx-btn></view></wrap><wrap><title type="h2">蒙层</title><desc type="prop" text="showMask">showMask</desc><desc type="prop" text="maskCloseable">maskCloseable</desc><mx-toast visible="{{visibleMask}}" content="{{content}}" time="{{time}}" showMask="{{true}}" bind:toast_close="handleClose" /><mx-toast visible="{{visibleMaskClose}}" content="{{content}}" time="{{time}}" showMask="{{true}}" maskCloseable="{{true}}" bind:toast_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleMask">显示蒙层</mx-btn><view class="space"></view><mx-btn width="200rpx" small bind:btn_tap="handleMaskClose">点击蒙层关闭</mx-btn></view></wrap><wrap><title type="h2">文字气泡圆角</title><desc type="prop" text="textType">textType</desc><desc type="value" text="short / long">short / long，默认 long</desc><mx-toast visible="{{visibleShort}}" content="{{content}}" time="{{time}}" textType="short" bind:toast_close="handleClose" /><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleShort">short 圆角</mx-btn></view></wrap><wrap><title type="h2">长文案截断</title><desc>最多显示 24 个字符，超出截断</desc><mx-toast visible="{{visibleLongText}}" content="{{content}}" time="{{time}}" bind:toast_close="handleClose" /><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleLongText">长文案</mx-btn></view></wrap><wrap><title type="h2">关闭事件</title><desc>事件：bind:toast_close</desc><desc>Toast 关闭时触发，需在回调中将 visible 置为 false</desc></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 