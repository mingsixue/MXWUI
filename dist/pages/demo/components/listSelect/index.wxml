<view class="pageDemo"><mx-nav title="列表选择" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="ListSelect">ListSelect</desc><desc>列表形式的选择组件，支持单选和多选。</desc></view><wrap><title type="h2">类型</title><desc type="prop" text="type">type</desc><desc type="value" text="single 单选、multiple 多选">single 单选、multiple 多选</desc><desc>single 单选</desc><mx-list-select options="{{options}}" type="single" bind:list_select_change="handleChange" /><line /><desc>multiple 多选</desc><mx-list-select options="{{options}}" type="multiple" bind:list_select_change="handleChange" /></wrap><wrap><title type="h2">数据项</title><desc type="prop" text="options">options</desc><desc type="prop" text="options[x].text">options[x].text</desc><desc type="prop" text="options[x].value">options[x].value</desc><desc type="prop" text="options[x].checked：true / false">options[x].checked：true / false</desc><desc type="prop" text="options[x].disabled：true / false">options[x].disabled：true / false</desc></wrap><wrap><title type="h2">单选框样式</title><desc type="prop" text="singleIcon">singleIcon</desc><desc type="value" text="default / radio">default / radio</desc><desc>default 默认样式</desc><mx-list-select options="{{options}}" type="single" singleIcon="default" bind:list_select_change="handleChange" /><line /><desc>radio 样式</desc><mx-list-select options="{{options}}" type="single" singleIcon="radio" bind:list_select_change="handleChange" /></wrap><wrap><title type="h2">复选框样式</title><desc type="prop" text="singleIcon">singleIcon</desc><desc type="value" text="default / checkbox">default / checkbox</desc><desc>default 默认样式</desc><mx-list-select options="{{options}}" type="multiple" multipleIcon="default" bind:list_select_change="handleChange" /><line /><desc>checkbox 样式</desc><mx-list-select options="{{options}}" type="multiple" multipleIcon="checkbox" bind:list_select_change="handleChange" /></wrap><wrap><title type="h2">单选框 / 复选框颜色</title><desc type="prop" text="iconColor">iconColor</desc><mx-list-select options="{{options}}" type="single" singleIcon="default" iconColor="#1677FF" bind:list_select_change="handleChange" /><line /><mx-list-select options="{{options}}" type="single" singleIcon="radio" iconColor="#1677FF" bind:list_select_change="handleChange" /><line /><mx-list-select options="{{options}}" type="multiple" multipleIcon="default" iconColor="#1677FF" bind:list_select_change="handleChange" /><line /><mx-list-select options="{{options}}" type="multiple" multipleIcon="checkbox" iconColor="#1677FF" bind:list_select_change="handleChange" /></wrap><wrap><title type="h2">单选框 / 复选框大小</title><desc type="prop" text="iconSize">iconSize</desc><desc type="value" text="默认 48">默认 48</desc><mx-list-select options="{{options}}" type="single" singleIcon="default" iconSize="30" bind:list_select_change="handleChange" /><line /><mx-list-select options="{{options}}" type="single" singleIcon="radio" iconSize="30" bind:list_select_change="handleChange" /><line /><mx-list-select options="{{options}}" type="multiple" multipleIcon="default" iconSize="30" bind:list_select_change="handleChange" /><line /><mx-list-select options="{{options}}" type="multiple" multipleIcon="checkbox" iconSize="30" bind:list_select_change="handleChange" /></wrap><wrap><title type="h2">文本颜色</title><desc type="prop" text="textColor">textColor</desc><desc type="value" text="未选中文本颜色">未选中文本颜色</desc><desc type="prop" text="textSelectColor">textSelectColor</desc><desc type="value" text="选中文本颜色">选中文本颜色</desc><mx-list-select options="{{options}}" textColor="#1677FF" textSelectColor="#CA0E2D" bind:list_select_change="handleChange" /></wrap><wrap><title type="h2">描述或错误文案</title><desc type="prop" text="desc">desc</desc><desc type="prop" text="descColor">descColor</desc><mx-list-select options="{{options}}" desc="请先选择选项" descColor="#CA0E2D" bind:list_select_change="handleChange" /></wrap><wrap><title type="h2">标签文案</title><desc type="prop" text="label">label</desc><desc type="prop" text="labelColor">labelColor</desc><mx-list-select options="{{options}}" label="标签文案" labelColor="#1677FF" bind:list_select_change="handleChange" /></wrap><wrap><title type="h2">是否显示必填星号</title><desc type="prop" text="required">required</desc><desc type="prop" text="requiredPosition">requiredPosition</desc><desc type="value" text="left、right">left、right</desc><mx-list-select options="{{options}}" label="必填星号在右侧" required bind:list_select_change="handleChange" /><line /><mx-list-select options="{{options}}" label="必填星号在左侧" required requiredPosition="left" bind:list_select_change="handleChange" /></wrap><wrap><title type="h2">标签前图标</title><desc type="prop" text="firstIcon">firstIcon</desc><mx-list-select options="{{options}}" label="自定义图标" firstIcon="{{firstIcon}}" bind:list_select_change="handleChange" bind:list_select_firstIcon="handleFirstIcon" /><line /><mx-list-select options="{{options}}" label="自定义图片" firstIcon="{{firstIcon2}}"  bind:list_select_change="handleChange" bind:list_select_firstIcon="handleFirstIcon" /></wrap><wrap><title type="h2">标签后图标</title><desc type="prop" text="lastIcon">lastIcon</desc><mx-list-select options="{{options}}" label="自定义图标" lastIcon="{{lastIcon}}" bind:list_select_change="handleChange" bind:list_select_lastIcon="handleLastIcon" /><line /><mx-list-select options="{{options}}" label="自定义图片" lastIcon="{{lastIcon2}}"  bind:list_select_change="handleChange" bind:list_select_lastIcon="handleLastIcon" /></wrap><wrap><title type="h2">背景色</title><desc type="prop" text="bgColor">bgColor</desc><mx-list-select options="{{options}}" bgColor="#eee" bind:list_select_change="handleChange" /></wrap><line /><prop-table dataSource="{{propDocs}}" /></view>