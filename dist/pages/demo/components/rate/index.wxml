<view class="pageDemo"><mx-nav title="评分" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Rate">Rate</desc><desc>用于展示事物评级以及快速打分</desc></view><wrap><title type="h2">基本用法</title><div class="cons"><mx-rate value="{{3}}" bind:rate_change="changeValue" /></div></wrap><wrap><title type="h2">半星</title><desc type="prop" text="allowHalf">allowHalf</desc><div class="cons"><mx-rate value="{{3.5}}" allowHalf bind:rate_change="changeValue" /></div></wrap><wrap><title type="h2">只读</title><desc type="prop" text="readonly">readonly</desc><div class="cons"><mx-rate value="{{4}}" readonly /></div></wrap><wrap><title type="h2">star 总数</title><desc type="prop" text="count">count</desc><div class="cons"><mx-rate value="{{3}}" count="{{10}}" /></div></wrap><wrap><title type="h2">允许清除</title><desc type="prop" text="allowClear">allowClear</desc><desc>再次点击相同星级可清除，设为 false 则不可清除</desc><div class="cons"><mx-rate value="{{3}}" allowClear="{{false}}" /></div></wrap><wrap><title type="h2">自定义间距</title><desc type="prop" text="gutter">gutter</desc><div class="cons"><mx-rate value="{{3}}" gutter="{{24}}" /></div></wrap><wrap><title type="h2">自定义大小</title><desc type="prop" text="size">size</desc><div class="cons"><mx-rate value="{{3}}" size="{{64}}" /></div></wrap><wrap><title type="h2">自定义颜色</title><desc type="prop" text="color / voidColor">color / voidColor</desc><div class="cons"><mx-rate value="{{3.5}}" allowHalf color="#CA0E2D" voidColor="#E1E5EC" /></div></wrap><wrap><title type="h2">自定义字符</title><desc type="prop" text="character">character</desc><div class="cons"><mx-rate value="{{3}}" character="好" color="#CA0E2D" /><view class="gap" /><mx-rate value="{{4}}" character="A" color="#1677FF" size="{{56}}" /></div></wrap><wrap><title type="h2">自定义图标</title><desc type="prop" text="icon">icon</desc><div class="cons"><mx-rate value="{{3.5}}" allowHalf icon="love_fill" color="#CA0E2D" voidColor="#E1E5EC" /></div></wrap><wrap><title type="h2">受控模式</title><desc type="prop" text="value + bind:rate_change">value + bind:rate_change</desc><div class="cons"><mx-rate value="{{controlledValue}}" bind:rate_change="changeControlled" /><view class="gap" /><mx-stepper value="{{controlledValue}}" min="{{0}}" max="{{5}}" bind:stepper_change="changeControlled" /></div></wrap><wrap><title type="h2">值变更事件</title><desc type="prop" text="bind:rate_change">bind:rate_change</desc><div class="cons"><mx-rate value="{{value}}" allowHalf bind:rate_change="changeValue" /><view class="tip">当前值：{{value}}</view></div></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 