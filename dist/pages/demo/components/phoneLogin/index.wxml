<view class="pageDemo"><mx-nav title="手机号登录" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="PhoneLogin">PhoneLogin</desc><desc>基于微信小程序手机号快速/实时验证能力，封装一键登录与协议确认。</desc><desc>授权成功后返回 code，需由服务端调用 phonenumber.getPhoneNumber 换取手机号。</desc></view><wrap><title type="h2">基础用法</title><desc type="prop" text="mode / showProtocol">mode / showProtocol</desc><desc type="value" text="quick + 协议勾选">quick + 协议勾选</desc><view class="phoneLoginPanel"><mx-phone-login logo="https://cdn.mingsixue.com/xcx/MXWUI/temp/avatar.jpg" protocolChecked="{{protocolChecked}}" protocolContent="{{protocolContent}}" bind:phone_login_success="handleSuccess" bind:phone_login_fail="handleFail" bind:phone_login_blocked="handleBlocked" bind:protocol_change="handleProtocolChange" bind:protocol_click="handleProtocolClick" /></view><view wx:if="{{lastResult}}" class="resultTip">{{lastResult}}</view></wrap><wrap><title type="h2">验证模式</title><desc type="prop" text="mode">mode</desc><desc type="value" text="quick / realtime">quick / realtime</desc><view class="phoneLoginPanel"><mx-phone-login mode="realtime" title="实时验证登录" desc="每次授权都会对手机号做实时校验" btnText="手机号实时验证登录" showProtocol="{{false}}" bind:phone_login_success="handleSuccess" bind:phone_login_fail="handleFail" /></view></wrap><wrap><title type="h2">不强制勾选协议</title><desc type="prop" text="requireProtocol">requireProtocol</desc><desc type="value" text="false">false</desc><view class="phoneLoginPanel"><mx-phone-login title="可选协议" requireProtocol="{{false}}" protocolContent="{{protocolContent}}" bind:phone_login_success="handleSuccess" bind:phone_login_fail="handleFail" bind:protocol_click="handleProtocolClick" /></view></wrap><wrap><title type="h2">自定义按钮样式</title><desc type="prop" text="themeColor / btnText / round">themeColor / btnText / round</desc><view class="phoneLoginPanel"><mx-phone-login title="" desc="" showProtocol="{{false}}" themeColor="#07c160" btnText="微信手机号快捷登录" round="{{true}}" bind:phone_login_success="handleSuccess" bind:phone_login_fail="handleFail" /></view><line /><view class="phoneLoginPanel"><mx-phone-login title="" desc="" showProtocol="{{false}}" themeColor="#1677FF" btnType="default" btnText="蓝色描边登录" round="{{false}}" bind:phone_login_success="handleSuccess" bind:phone_login_fail="handleFail" /></view></wrap><wrap><title type="h2">授权后附带 wx.login</title><desc type="prop" text="autoWxLogin">autoWxLogin</desc><desc type="value" text="true">true</desc><view class="phoneLoginPanel"><mx-phone-login title="带回 loginCode" desc="成功回调中额外返回 loginCode，便于服务端建会话" showProtocol="{{false}}" autoWxLogin bind:phone_login_success="handleSuccess" bind:phone_login_fail="handleFail" /></view></wrap><wrap><title type="h2">禁用状态</title><desc type="prop" text="disabled">disabled</desc><desc type="value" text="true">true</desc><view class="phoneLoginPanel"><mx-phone-login title="" desc="" showProtocol="{{false}}" disabled btnText="暂不可登录" /></view></wrap><wrap><title type="h2">额度用尽提示</title><desc type="prop" text="phoneNumberNoQuotaToast">phoneNumberNoQuotaToast</desc><desc type="value" text="true / false">true / false</desc><view class="phoneLoginPanel"><mx-phone-login title="" desc="关闭后额度不足时由业务自行处理（errno=1400001）" showProtocol="{{false}}" phoneNumberNoQuotaToast="{{false}}" bind:phone_login_success="handleSuccess" bind:phone_login_fail="handleFail" /></view></wrap><prop-table dataSource="{{propDocs}}" /></view> 