<view class="pageDemo"><mx-nav title="协议" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Protocol">Protocol</desc><desc>适用于一些需要用户确认或同意协议后才能操作的场景。</desc></view><wrap><title type="h2">文案内容</title><desc type="prop" text="content">content</desc><desc type="value" text="数组形式，提供多段文本">数组形式，提供多段文本</desc><desc type="prop" text="content[x].text">content[x].text</desc><desc type="value" text="内容">内容</desc><desc type="prop" text="content[x].color">content[x].color</desc><desc type="value" text="文本颜色">文本颜色</desc><view class="cons"><mx-protocol content="{{content}}" bind:protocol_change="handleChange" bind:protocol_click="handleTap" /></view><view class="cons"><mx-protocol content="{{content2}}"  changeChecked="{{false}}"  bind:protocol_change="handleChange" bind:protocol_click="handleTap" /></view></wrap><wrap><title type="h2">是否选中</title><desc type="prop" text="checked">checked</desc><view class="cons"><mx-protocol checked="{{true}}" content="{{content}}" bind:protocol_change="handleChange" bind:protocol_click="handleTap" /></view></wrap><wrap><title type="h2">是否禁用</title><desc type="prop" text="disabled">disabled</desc><view class="cons"><mx-protocol disabled="{{true}}" content="{{content}}" bind:protocol_change="handleChange" bind:protocol_click="handleTap" /></view></wrap><wrap><title type="h2">复选框颜色</title><desc type="prop" text="checkboxColor">checkboxColor</desc><desc type="value" text="未选中颜色">未选中颜色</desc><desc type="prop" text="checkboxSelectColor">checkboxSelectColor</desc><desc type="value" text="选中颜色">选中颜色</desc><view class="cons"><mx-protocol checkboxColor="#000" checkboxSelectColor="#1677FF" content="{{content}}" bind:protocol_change="handleChange" bind:protocol_click="handleTap" /></view></wrap><wrap><title type="h2">复选框大小</title><desc type="prop" text="checkboxSize">checkboxSize</desc><desc type="value" text="默认32">默认32</desc><view class="cons"><mx-protocol checkboxSize="48" checked content="{{content}}" bind:protocol_change="handleChange" bind:protocol_click="handleTap" /></view></wrap><wrap><title type="h2">点击文本是否可以选中或取消</title><desc type="prop" text="changeChecked">changeChecked</desc><desc type="value" text="默认可操作">默认可操作</desc><view class="cons"><mx-protocol changeChecked content="{{content3}}" bind:protocol_change="handleChange" bind:protocol_click="handleTap" /></view><view class="cons"><mx-protocol changeChecked="{{false}}" checked content="{{content4}}" bind:protocol_change="handleChange" bind:protocol_click="handleTap" /></view></wrap><prop-table dataSource="{{propDocs}}" /></view>