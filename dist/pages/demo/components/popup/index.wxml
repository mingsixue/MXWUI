<view class="pageDemo"><mx-nav title="侧边弹窗" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Popup">Popup</desc><desc>适用于侧边打开弹窗的场景，提供容器，内容完全自定义。</desc></view><wrap><title type="h2">是否显示弹窗</title><desc type="prop" text="visible">visible</desc><mx-popup visible="{{false}}">内容</mx-popup></wrap><wrap><title type="h2">类型</title><desc type="prop" text="type">type</desc><desc type="value" text="left / right，默认right">left / right，默认right</desc><mx-popup visible="{{visible}}" type="{{type}}" bind:popup_close="handleDialogClose"><view class="custom" bind:tap="handleClose"> 点这里关闭 </view></mx-popup><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleLeft">左侧</mx-btn><view class="space"></view><mx-btn width="120rpx" small bind:btn_tap="handleRight">右侧</mx-btn></view></wrap><wrap><title type="h2">宽度</title><desc type="prop" text="width">width</desc><desc type="value" text="带单位，默认80vw">带单位，默认80vw</desc><mx-popup visible="{{visibleWidth}}" type="left" width="{{width}}" bind:popup_close="handleDialogClose"><view class="custom" bind:tap="handleClose"> 点这里关闭 </view></mx-popup><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleWidth">400rpx</mx-btn><view class="space"></view><mx-btn width="120rpx" small bind:btn_tap="handleWidth2">320px</mx-btn><view class="space"></view><mx-btn width="120rpx" small bind:btn_tap="handleWidth3">50%</mx-btn></view></wrap><wrap><title type="h2">层级</title><desc type="prop" text="zIndex">zIndex</desc><mx-popup visible="{{false}}" zIndex="2"><view class="custom" bind:tap="handleClose"> 点这里关闭 </view></mx-popup></wrap><wrap><title type="h2">蒙层是否可以关闭弹窗</title><desc type="prop" text="isCloseMask">isCloseMask</desc><desc type="prop" text="bind:popup_close">bind:popup_close</desc><mx-popup visible="{{visibleMask}}" isCloseMask="{{isCloseMask}}" bind:popup_close="handleDialogClose"><view class="custom" bind:tap="handleClose"> 点这里关闭 </view></mx-popup><view class="cons"><mx-btn width="140rpx" small bind:btn_tap="handleMask">不可关闭</mx-btn><view class="space"></view><mx-btn width="120rpx" small bind:btn_tap="handleMask2">可关闭</mx-btn></view></wrap><prop-table dataSource="{{propDocs}}" /></view>