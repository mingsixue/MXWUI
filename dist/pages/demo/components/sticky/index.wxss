.pageDemo{min-height:100vh;padding-bottom:48rpx;padding-bottom:calc(constant(safe-area-inset-bottom) + 48rpx);padding-bottom:calc(env(safe-area-inset-bottom) + 48rpx);background:#f8f9fa;box-sizing:border-box}.demoIntro{position:relative;padding:32rpx 0 20rpx;margin-bottom:8rpx}.demoIntro::before{content:'';position:absolute;left:0;right:0;top:0;bottom:0;z-index:0;background:radial-gradient(ellipse 80% 90% at 0 0,rgba(202,14,45,.1) 0,transparent 55%),linear-gradient(180deg,#fff 0,#f8f9fa 100%);pointer-events:none}.demoIntro>desc,.demoIntro>title,.demoIntro>view{position:relative;z-index:1}.cons{display:flex;flex-wrap:wrap;align-items:center;margin:8rpx 48rpx 16rpx}.cons .space{display:inline-block;width:24rpx}.pageDemo .cons{display:block;margin:8rpx 0 16rpx}.pageDemo .tip{margin:0 48rpx 16rpx;font-size:24rpx;color:#9aa0b1;line-height:1.5}.pageDemo .stickyBar{display:flex;align-items:center;justify-content:space-between;height:88rpx;padding:0 32rpx;background:#ca0e2d;color:#fff;font-size:28rpx;box-sizing:border-box}.pageDemo .stickyBar.secondary{background:#1677ff}.pageDemo .stickyBar.success{background:#098562}.pageDemo .stickyBar.warn{background:#ff8f1f}.pageDemo .stickyStatus{font-size:24rpx;opacity:.9}.pageDemo .block{margin:0 24rpx;padding:24rpx;background:#fff;border-radius:16rpx;border:1rpx solid #eff0f5}.pageDemo .blockItem{padding:20rpx 0;font-size:28rpx;color:#040a23;border-bottom:1rpx solid #f2f3f7}.pageDemo .blockItem:last-child{border-bottom:none}.pageDemo .spacer{height:240rpx}.pageDemo .sectionGap{height:48rpx}