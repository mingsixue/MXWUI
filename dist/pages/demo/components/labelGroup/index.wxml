<view class="pageDemo"><mx-nav title="标签按钮组" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="LabelGroup">LabelGroup</desc><desc>在一组数据中选择一个或多个值，多用于筛选场景。</desc></view><wrap><title type="h2">类型</title><desc type="prop" text="type">type</desc><desc type="value" text="single 单选、multiple 多选">single 单选、multiple 多选</desc><mx-label-group options="{{options}}" type="single" bind:label_group_change="handleChange" /><line /><mx-label-group options="{{options}}" type="multiple" bind:label_group_change="handleChange" /></wrap><wrap><title type="h2">数据项</title><desc type="prop" text="options">options</desc><desc type="prop" text="options[x].text">options[x].text</desc><desc type="prop" text="options[x].value">options[x].value</desc><desc type="prop" text="options[x].checked：true / false">options[x].checked：true / false</desc><desc type="prop" text="options[x].disabled：true / false">options[x].disabled：true / false</desc></wrap><wrap><title type="h2">文本色</title><desc type="prop" text="textColor">textColor</desc><mx-label-group options="{{options}}" textColor="#1677FF" bind:label_group_change="handleChange" /><line /><mx-label-group options="{{options}}" type="multiple" textColor="#1677FF" bind:label_group_change="handleChange" /></wrap><wrap><title type="h2">选中颜色</title><desc type="prop" text="selectColor">selectColor</desc><mx-label-group options="{{options}}" selectColor="#1677FF" bind:label_group_change="handleChange" /><line /><mx-label-group options="{{options}}" type="multiple" selectColor="#1677FF" bind:label_group_change="handleChange" /></wrap><wrap><title type="h2">描述或错误文案</title><desc type="prop" text="selectColor">selectColor</desc><mx-label-group options="{{options}}" desc="请先选择选项" descColor="#CA0E2D" bind:label_group_change="handleChange" /></wrap><wrap><title type="h2">标签文案</title><desc type="prop" text="label">label</desc><desc type="prop" text="labelColor">labelColor</desc><mx-label-group options="{{options}}" label="标签文案" labelColor="#1677FF" bind:label_group_change="handleChange" /></wrap><wrap><title type="h2">是否显示必填星号</title><desc type="prop" text="required">required</desc><desc type="prop" text="requiredPosition">requiredPosition</desc><desc type="value" text="left、right">left、right</desc><mx-label-group options="{{options}}" label="必填星号在右侧" required bind:label_group_change="handleChange" /><line /><mx-label-group options="{{options}}" label="必填星号在左侧" required requiredPosition="left" bind:label_group_change="handleChange" /></wrap><wrap><title type="h2">标签前图标</title><desc type="prop" text="firstIcon">firstIcon</desc><mx-label-group options="{{options}}" label="自定义图标" firstIcon="{{firstIcon}}" bind:label_group_change="handleChange" bind:label_group_firstIcon="handleFirstIcon" /><line /><mx-label-group options="{{options}}" label="自定义图片" firstIcon="{{firstIcon2}}"  bind:label_group_change="handleChange" bind:label_group_firstIcon="handleFirstIcon" /></wrap><wrap><title type="h2">标签后图标</title><desc type="prop" text="lastIcon">lastIcon</desc><mx-label-group options="{{options}}" label="自定义图标" lastIcon="{{lastIcon}}" bind:label_group_change="handleChange" bind:label_group_lastIcon="handleLastIcon" /><line /><mx-label-group options="{{options}}" label="自定义图片" lastIcon="{{lastIcon2}}"  bind:label_group_change="handleChange" bind:label_group_lastIcon="handleLastIcon" /></wrap><wrap><title type="h2">背景色</title><desc type="prop" text="bgColor">bgColor</desc><mx-label-group options="{{options}}" bgColor="#f2f2f2" bind:label_group_change="handleChange" /></wrap><prop-table dataSource="{{propDocs}}" /></view>