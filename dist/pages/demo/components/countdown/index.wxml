<view class="pageDemo"><mx-nav title="倒计时" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Countdown">Countdown</desc><desc>用于展示剩余时间，支持时分秒与天数，可配置起止时间或时长</desc></view><wrap><title type="h2">基本用法</title><desc type="prop" text="time">time</desc><view class="cons"><mx-countdown time="{{timeBasic}}" prefix="剩余" suffix="后结束" /></view></wrap><wrap><title type="h2">结束时间戳</title><desc type="prop" text="countdownEndTime">countdownEndTime</desc><view class="cons"><mx-countdown countdownEndTime="{{endTime}}" prefix="距活动结束还剩" /></view></wrap><wrap><title type="h2">展示天数</title><desc type="prop" text="countdownType">countdownType="day"</desc><view class="cons consGap"><mx-countdown countdownType="day" countdownEndTime="{{endTimeDay}}" prefix="距开抢还剩" /><mx-countdown countdownType="day" countdownEndTime="{{endTimeShort}}" prefix="不足一天" suffix="（自动隐藏天）" /></view></wrap><wrap><title type="h2">强制展示天</title><desc type="prop" text="autoShowDay">autoShowDay</desc><view class="cons"><mx-countdown countdownType="day" autoShowDay="{{false}}" countdownEndTime="{{endTimeForceDay}}" prefix="不足一天也展示" /></view></wrap><wrap><title type="h2">插槽前后缀</title><desc type="prop" text="slot">prefix / suffix</desc><view class="cons"><mx-countdown time="{{120}}"><text slot="prefix" class="slotText">距离开始</text><text slot="suffix" class="slotText">，请耐心等待</text></mx-countdown></view></wrap><wrap><title type="h2">自定义颜色</title><desc type="prop" text="numberBg">numberBg</desc><desc type="prop" text="numberColor">numberColor</desc><desc type="prop" text="color">color</desc><view class="cons consGap"><mx-countdown time="{{3600}}" prefix="主题色" numberBg="#1677FF" /><mx-countdown time="{{1800}}" prefix="自定义" color="#040A23" numberBg="#098562" numberColor="#FFFFFF" /><mx-countdown countdownType="day" countdownEndTime="{{endTimeDay}}" prefix="浅色底" color="#656979" numberBg="#EFF0F5" numberColor="#CA0E2D" /></view></wrap><wrap><title type="h2">事件回调</title><desc type="prop" text="countdown_change">countdown_change</desc><desc type="prop" text="countdown_finish">countdown_finish</desc><desc type="value" text="{{changeLog}}">{{changeLog}}</desc><desc type="value" text="{{finishLog}}">{{finishLog}}</desc><view class="cons"><mx-countdown countdownEndTime="{{eventEndTime}}" prefix="还剩" bind:countdown_change="handleCountdownChange" bind:countdown_finish="handleCountdownFinish" /></view><view class="btnRow"><mx-btn width="200rpx" small bind:btn_tap="handleRestart">重新开始</mx-btn></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 