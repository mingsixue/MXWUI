<view class="pageDemo"><mx-nav title="滑动操作" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="SwipeAction">SwipeAction</desc><desc>通过滑动露出隐藏操作按钮，常用于列表删除、置顶等场景</desc></view><wrap><title type="h2">基本用法</title><desc type="prop" text="rightButtons">rightButtons</desc><view class="swipeTip">向左滑动查看操作按钮</view><view class="swipeList"><view class="swipeItem"><mx-swipe-action rightButtons="{{rightButtons}}" bind:button_tap="handleButtonTap" ><view class="swipeCell">右侧单个删除按钮</view></mx-swipe-action></view></view></wrap><wrap><title type="h2">多个右侧按钮</title><desc type="prop" text="rightButtons">rightButtons</desc><view class="swipeList"><view class="swipeItem"><mx-swipe-action rightButtons="{{rightButtonsMulti}}" bind:button_tap="handleButtonTap" ><view class="swipeCell">收藏 + 删除</view></mx-swipe-action></view></view></wrap><wrap><title type="h2">左侧按钮</title><desc type="prop" text="leftButtons">leftButtons</desc><view class="swipeTip">向右滑动查看操作按钮</view><view class="swipeList"><view class="swipeItem"><mx-swipe-action leftButtons="{{leftButtons}}" bind:button_tap="handleButtonTap" ><view class="swipeCell">右侧滑动露出置顶</view></mx-swipe-action></view></view></wrap><wrap><title type="h2">左右两侧都有按钮</title><desc type="prop" text="leftButtons">leftButtons</desc><desc type="prop" text="rightButtons">rightButtons</desc><view class="swipeList"><view class="swipeItem"><mx-swipe-action leftButtons="{{leftRightLeft}}" rightButtons="{{leftRightRight}}" bind:button_tap="handleButtonTap" ><view class="swipeCell">左右均可滑动</view></mx-swipe-action></view></view></wrap><wrap><title type="h2">自定义颜色与宽度</title><desc type="prop" text="bgColor">bgColor</desc><desc type="prop" text="width">width</desc><view class="swipeList"><view class="swipeItem"><mx-swipe-action rightButtons="{{customButtons}}" bind:button_tap="handleButtonTap" ><view class="swipeCell">自定义按钮样式</view></mx-swipe-action></view><view class="swipeItem"><mx-swipe-action rightButtons="{{widthButtons}}" bind:button_tap="handleButtonTap" ><view class="swipeCell">自定义按钮宽度</view></mx-swipe-action></view></view></wrap><wrap><title type="h2">禁止滑动</title><desc type="prop" text="disabled">disabled</desc><view class="swipeList"><view class="swipeItem"><mx-swipe-action disabled rightButtons="{{rightButtons}}" ><view class="swipeCell">disabled 状态下无法滑动</view></mx-swipe-action></view></view></wrap><wrap><title type="h2">点击不自动收起</title><desc type="prop" text="autoClose">autoClose</desc><view class="swipeList"><view class="swipeItem"><mx-swipe-action autoClose="{{false}}" rightButtons="{{rightButtonsMulti}}" bind:button_tap="handleButtonTap" ><view class="swipeCell">点击按钮后保持展开</view></mx-swipe-action></view></view></wrap><wrap><title type="h2">关闭弹性回弹</title><desc type="prop" text="elasticity">elasticity</desc><view class="swipeList"><view class="swipeItem"><mx-swipe-action elasticity="{{false}}" rightButtons="{{rightButtonsMulti}}" bind:button_tap="handleButtonTap" ><view class="swipeCell">elasticity = false</view></mx-swipe-action></view></view></wrap><wrap><title type="h2">默认展开</title><desc type="prop" text="defaultSwiped">defaultSwiped</desc><view class="swipeList"><view class="swipeItem"><mx-swipe-action defaultSwiped="right" rightButtons="{{rightButtons}}" bind:button_tap="handleButtonTap" ><view class="swipeCell">默认展开右侧</view></mx-swipe-action></view></view></wrap><wrap><title type="h2">列表场景</title><desc type="prop" text="name">name</desc><desc type="value" text="同时只展开一项，点击删除可二次确认">同时只展开一项，点击删除可二次确认</desc><view class="swipeList"><view class="swipeItem" wx:for="{{list}}" wx:key="id"><mx-swipe-action name="{{index}}" rightButtons="{{rightButtons}}" bind:swipe_start="handleSwipeStart" bind:swipe_end="handleSwipeEnd" bind:button_tap="handleDelete" ><view class="swipeCell"><text class="swipeCellTitle">{{item.title}}</text><text class="swipeCellDesc">{{item.content}}</text></view></mx-swipe-action></view></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 