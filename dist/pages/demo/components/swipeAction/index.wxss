.pageDemo{min-height:100vh;padding-bottom:48rpx;padding-bottom:calc(constant(safe-area-inset-bottom) + 48rpx);padding-bottom:calc(env(safe-area-inset-bottom) + 48rpx);background:#f8f9fa;box-sizing:border-box}.demoIntro{position:relative;padding:32rpx 0 20rpx;margin-bottom:8rpx}.demoIntro::before{content:'';position:absolute;left:0;right:0;top:0;bottom:0;z-index:0;background:radial-gradient(ellipse 80% 90% at 0 0,rgba(202,14,45,.1) 0,transparent 55%),linear-gradient(180deg,#fff 0,#f8f9fa 100%);pointer-events:none}.demoIntro>desc,.demoIntro>title,.demoIntro>view{position:relative;z-index:1}.cons{display:flex;flex-wrap:wrap;align-items:center;margin:8rpx 48rpx 16rpx}.cons .space{display:inline-block;width:24rpx}.pageDemo .swipeList{margin:8rpx 24rpx 16rpx;overflow:hidden;border-radius:8rpx;background:#fff}.pageDemo .swipeList .mx-list-basic{width:100%;box-sizing:border-box}.pageDemo .swipeItem{border-bottom:1rpx solid #e1e5ec}.pageDemo .swipeItem:last-child{border-bottom:none}.pageDemo .swipeCell{display:flex;align-items:center;justify-content:space-between;min-height:96rpx;padding:24rpx 32rpx;box-sizing:border-box;background:#fff;font-size:30rpx;color:#040a23}.pageDemo .swipeCellTitle{flex-shrink:0;margin-right:24rpx}.pageDemo .swipeCellDesc{flex:1;min-width:0;text-align:right;color:#9aa0b1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pageDemo .swipeTip{margin:8rpx 48rpx 24rpx;font-size:24rpx;color:#9aa0b1;line-height:1.5}