<view class="pageDemo"><mx-nav title="序列索引" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="IndexBar">IndexBar</desc><desc>侧边索引，适用于通讯录等长列表快速定位。</desc></view><wrap><title type="h2">基本用法</title><desc type="prop" text="list">list</desc><desc type="value" text="分组列表数据">分组列表数据</desc><view class="indexDemoBox"><mx-index-bar list="{{list}}" defaultCurrent="A" height="720rpx" bind:change="handleChange" bind:select="handleSelect" /></view><view wx:if="{{currentLabel}}" class="currentTip">当前索引：{{currentLabel}}</view></wrap><wrap><title type="h2">索引数组</title><desc type="prop" text="items">items</desc><desc type="prop" text="items[x].label">items[x].label</desc><desc type="value" text="索引标识">索引标识</desc><desc type="prop" text="items[x].disablePreview">items[x].disablePreview</desc><desc type="value" text="禁用预览气泡">禁用预览气泡</desc><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" items="{{itemsNoPreview}}" height="480rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">默认索引</title><desc type="prop" text="defaultCurrent">defaultCurrent</desc><desc type="value" text="默认 A">默认 A</desc><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" defaultCurrent="H" height="480rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">受控索引</title><desc type="prop" text="current">current</desc><desc type="value" text="C / L">C / L</desc><view class="demoAction"><mx-btn width="240rpx" small bind:btn_tap="handleSetCurrent">切换为 {{nextCurrent}}</mx-btn></view><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" current="{{current}}" height="480rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">索引尺寸</title><desc type="prop" text="size">size</desc><desc type="value" text="默认 16，单位 px">默认 16，单位 px</desc><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" size="20" height="480rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">组件高度</title><desc type="prop" text="height">height</desc><desc type="value" text="默认 100%，带单位">默认 100%，带单位</desc><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" height="360rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">激活态颜色</title><desc type="prop" text="activeColor">activeColor</desc><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" activeColor="#1677FF" height="480rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">索引文字颜色</title><desc type="prop" text="textColor">textColor</desc><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" textColor="#040A23" height="480rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">预览气泡颜色</title><desc type="prop" text="tipBgColor">tipBgColor</desc><desc type="prop" text="tipColor">tipColor</desc><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" tipBgColor="#1677FF" tipColor="#FFFFFF" height="480rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">分组标题颜色</title><desc type="prop" text="headerBgColor">headerBgColor</desc><desc type="prop" text="headerColor">headerColor</desc><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" headerBgColor="#EFF0F5" headerColor="#CA0E2D" height="480rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">是否吸顶</title><desc type="prop" text="sticky">sticky</desc><desc type="value" text="默认 true">默认 true</desc><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" sticky="{{false}}" height="480rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">是否显示头像</title><desc type="prop" text="showAvatar">showAvatar</desc><desc type="value" text="默认 true">默认 true</desc><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" showAvatar="{{false}}" height="480rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">头像尺寸</title><desc type="prop" text="avatarSize">avatarSize</desc><desc type="value" text="默认 72，单位 rpx">默认 72，单位 rpx</desc><view class="indexDemoBox"><mx-index-bar list="{{shortList}}" avatarSize="96" height="480rpx" bind:select="handleSelect" /></view></wrap><wrap><title type="h2">自定义事件</title><desc type="prop" text="bind:change">bind:change</desc><desc type="value" text="索引改变回调">索引改变回调</desc><desc type="prop" text="bind:select">bind:select</desc><desc type="value" text="列表项点击回调">列表项点击回调</desc></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 