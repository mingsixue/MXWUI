<view class="pageDemo"><mx-nav title="输入框" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Input">Input</desc><desc>一般用在表单，需要进行信息的收集的地方，提供输入功能，基于微信小程序 input 组件的封装。</desc></view><wrap><title type="h2">基本用法</title><mx-input bind:input_change="inputChange" bind:input_focus="inputFocus" bind:input_blur="inputBlur" bind:input_confirm="inputConfirm" bind:input_keyboard_height_change="inputKeyboardHeightChange" /></wrap><wrap><title type="h2">样式类型</title><desc type="prop" text="styleType">styleType</desc><desc type="value" text="normal、horizontal、vertical、web">normal、horizontal、vertical、web</desc></wrap><wrap><title type="h2">类型</title><desc type="prop" text="type">type</desc><desc type="value" text="同微信小程序的类型">同微信小程序的类型</desc><line /><desc>type：text</desc><mx-input type="text" /><line /><desc>type：number</desc><mx-input type="number" /><line /><desc>type：idcard</desc><mx-input type="idcard" /><line /><desc>type：digit</desc><mx-input type="digit" /><line /><desc>type：nickname</desc><mx-input type="nickname" /></wrap><wrap><title type="h2">是否是密码类型</title><desc type="prop" text="password">password</desc><mx-input password="{{true}}" value="1234" /></wrap><wrap><title type="h2">值</title><desc type="prop" text="value">value</desc><mx-input value="1234" /></wrap><wrap><title type="h2">占位文本</title><desc type="prop" text="placeholder">placeholder</desc><desc type="prop" text="placeholderColor">placeholderColor</desc><mx-input placeholder="请输入内容" /><mx-input placeholder="请输入内容" placeholderColor="#f00" /></wrap><wrap><title type="h2">是否禁用输入框</title><desc type="prop" text="disabled">disabled</desc><mx-input disabled="{{true}}" /></wrap><wrap><title type="h2">最大输入长度</title><desc type="prop" text="maxLength">maxLength</desc><mx-input maxLength="5" /></wrap><wrap><title type="h2">指定光标与键盘的距离</title><desc type="prop" text="cursorSpacing">cursorSpacing</desc><mx-input cursorSpacing="0" /></wrap><wrap><title type="h2">获取焦点</title><desc type="prop" text="focus">focus</desc><mx-input focus="{{false}}" /></wrap><wrap><title type="h2">设置键盘右下角按钮的文字</title><desc type="prop" text="focus">focus</desc><desc type="value" text="send 发送、search 搜索、next 下一个、go 前往、done 完成">send 发送、search 搜索、next 下一个、go 前往、done 完成</desc><desc>仅在type='text'时生效</desc><mx-input type="text" confirmType="send" /></wrap><wrap><title type="h2">强制 input 处于同层状态</title><desc type="prop" text="alwaysEmbed">alwaysEmbed</desc><desc type="value" text="默认 focus 时 input 会切到非同层状态 (仅在 iOS 下生效)">默认 focus 时 input 会切到非同层状态 (仅在 iOS 下生效)</desc><mx-input alwaysEmbed="{{true}}" /></wrap><wrap><title type="h2">点击键盘右下角按钮时是否保持键盘不收起</title><desc type="prop" text="confirmHold">confirmHold</desc><mx-input placeholder="不收起" confirmHold="{{true}}" /><mx-input placeholder="收起" confirmHold="{{false}}" /></wrap><wrap><title type="h2">指定focus时的光标位置</title><desc type="prop" text="cursor">cursor</desc><mx-input cursor="3" value="12345" /></wrap><wrap><title type="h2">光标颜色</title><desc type="prop" text="cursorColor">cursorColor</desc><mx-input cursorColor="#1677FF" /></wrap><wrap><title type="h2">光标起始位置</title><desc type="prop" text="selectionStart">selectionStart</desc><desc type="value" text="自动聚集时有效，需与selectionEnd搭配使用">自动聚集时有效，需与selectionEnd搭配使用</desc></wrap><wrap><title type="h2">光标结束位置</title><desc type="prop" text="selectionEnd">selectionEnd</desc><desc type="value" text="自动聚集时有效，需与selectionStart搭配使用">自动聚集时有效，需与selectionStart搭配使用</desc></wrap><wrap><title type="h2">键盘弹起时，是否自动上推页面</title><desc type="prop" text="adjustPosition">adjustPosition</desc><mx-input placeholder="不往上推" adjustPosition="{{false}}" /><mx-input placeholder="往上推" adjustPosition="{{true}}" /></wrap><wrap><title type="h2">focus时，点击页面的时候不收起键盘</title><desc type="prop" text="holdKeyboard">holdKeyboard</desc><mx-input placeholder="收起" holdKeyboard="{{false}}" /><mx-input placeholder="不收起" holdKeyboard="{{true}}" /></wrap><wrap><title type="h2">描述或错误文案</title><desc type="prop" text="desc">desc</desc><mx-input desc="仅支持字母、数字和下划线" bind:input_change="inputChange" /></wrap><wrap><title type="h2">描述或错误文案颜色</title><desc type="prop" text="descColor">descColor</desc><mx-input desc="这是错误提示" descColor="#CA0E2D" bind:input_change="inputChange" /></wrap><wrap><title type="h2">是否显示分隔线</title><desc type="prop" text="showLine">showLine</desc><mx-input showLine="{{false}}" /></wrap><wrap><title type="h2">标签文案</title><desc type="prop" text="label">label</desc><desc type="prop" text="labelColor">labelColor</desc><desc type="prop" text="labelAlign">labelAlign</desc><desc type="value" text="对齐方式，left / center / right">对齐方式，left / center / right</desc><mx-input styleType="horizontal" label="标签文案" /><mx-input styleType="horizontal" label="标签文案" labelColor="#1677FF" /></wrap><wrap><title type="h2">左侧自定义宽度，不带单位</title><desc type="prop" text="leftWidth">leftWidth</desc><mx-input styleType="horizontal" label="左侧自定义宽度" leftWidth="260" /></wrap><wrap><title type="h2">是否显示必填星号</title><desc type="prop" text="required">required</desc><desc type="prop" text="requiredPosition">requiredPosition</desc><desc type="value" text="left、right">left、right</desc><mx-input styleType="horizontal" label="标签文案" required /><mx-input styleType="horizontal" label="标签文案" required requiredPosition="left" /></wrap><wrap><title type="h2">标签前图标</title><desc type="prop" text="firstIcon">firstIcon</desc><mx-input styleType="horizontal" label="标签文本" firstIcon="{{firstIcon}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" /><mx-input styleType="horizontal" label="标签文本" firstIcon="{{firstIcon2}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" /></wrap><wrap><title type="h2">标签后图标</title><desc type="prop" text="lastIcon">lastIcon</desc><mx-input styleType="horizontal" label="标签文本" lastIcon="{{lastIcon}}" bind:input_change="inputChange" bind:input_lastIcon="handleLastIcon" /><mx-input styleType="horizontal" label="标签文本" lastIcon="{{lastIcon2}}" bind:input_change="inputChange" bind:input_lastIcon="handleLastIcon" /></wrap><wrap><title type="h2">输入框文本对齐方式</title><desc type="prop" text="inputAlign">inputAlign</desc><desc type="value" text="left、right">left、right</desc><mx-input styleType="horizontal" label="左对齐" inputAlign bind:input_change="inputChange" /><mx-input styleType="horizontal" label="右对齐" inputAlign="right" bind:input_change="inputChange" /></wrap><wrap><title type="h2">是否显示清除按钮</title><desc type="prop" text="clear">clear</desc><mx-input value="不显示清除按钮" clear="{{false}}" /><mx-input value="显示清除按钮" clear="{{true}}" /></wrap><wrap><title type="h2">输入框宽度</title><desc type="prop" text="inputWidth">inputWidth</desc><desc type="value" text="默认rpx，不带单位">默认rpx，不带单位</desc><desc>styleType="web" 时有效</desc><mx-input styleType="web" label="自定义宽度" inputWidth="300" /></wrap><wrap><title type="h2">输入框背景色</title><desc type="prop" text="inputBgColor">inputBgColor</desc><desc type="value" text='styleType="web" 时有效'>styleType="web" 时有效</desc><mx-input styleType="web" label="自定义背景色" inputBgColor="#e2e2e2" /></wrap><wrap><title type="h2">横向布局</title><desc type="prop" text="horizontal">horizontal</desc><desc type="value" text='styleType="web" 时有效'>styleType="web" 时有效</desc><mx-input styleType="web" label="横向布局" horizontal /></wrap><wrap><title type="h2">事件</title><desc type="prop" text="bind:input_change">bind:input_change</desc><desc type="value" text="值变更事件">值变更事件</desc><desc type="prop" text="bind:input_focus">bind:input_focus</desc><desc type="value" text="输入框获得焦点事件">输入框获得焦点事件</desc><desc type="prop" text="bind:input_blur">bind:input_blur</desc><desc type="value" text="输入框失去焦点事件">输入框失去焦点事件</desc><desc type="prop" text="bind:input_confirm">bind:input_confirm</desc><desc type="value" text="点击完成按钮时触发">点击完成按钮时触发</desc><desc type="prop" text="bind:input_keyboard_height_change">bind:input_keyboard_height_change</desc><desc type="value" text="键盘高度发生变化的时候触发此事件">键盘高度发生变化的时候触发此事件</desc><desc type="prop" text="bind:input_firstIcon">bind:input_firstIcon</desc><desc type="value" text="标签前图标点击事件">标签前图标点击事件</desc><desc type="prop" text="bind:input_lastIcon">bind:input_lastIcon</desc><desc type="value" text="标签后图标点击事件">标签后图标点击事件</desc><mx-input label="事件" bind:input_change="inputChange" bind:input_focus="inputFocus" bind:input_blur="inputBlur" bind:input_confirm="inputConfirm" bind:input_keyboard_height_change="inputKeyboardHeightChange" /></wrap><wrap><title type="h2">样式一：normal</title><mx-input styleType="normal" bind:input_change="inputChange" /><mx-input styleType="normal" placeholder="请输入内容" placeholderColor="#f00" bind:input_change="inputChange" /><mx-input styleType="normal" value="纳兰忱" bind:input_change="inputChange" /><mx-input styleType="normal" value="禁用" disabled bind:input_change="inputChange" /><mx-input styleType="normal" desc="这是描述内容哦" bind:input_change="inputChange" /><mx-input styleType="normal" desc="这是错误提示信息" descColor="#f00" showLine="{{false}}" bind:input_change="inputChange" /></wrap><wrap><title type="h2">样式二：horizontal</title><mx-input styleType="horizontal" label="标签文本" bind:input_change="inputChange" /><mx-input styleType="horizontal" label="标签文本" labelColor="#1677FF" bind:input_change="inputChange" /><mx-input styleType="horizontal" label="标签文本" placeholder="请输入内容" placeholderColor="#f00" bind:input_change="inputChange" /><mx-input styleType="horizontal" label="标签文本" value="纳兰忱" bind:input_change="inputChange" /><mx-input styleType="horizontal" label="禁用" disabled bind:input_change="inputChange" /><mx-input styleType="horizontal" label="标签文本" required bind:input_change="inputChange" /><mx-input styleType="horizontal" label="标签文本" required requiredPosition="left" bind:input_change="inputChange" /><mx-input styleType="horizontal" label="自定义图标" firstIcon="{{firstIcon}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" /><mx-input styleType="horizontal" label="自定义图片" firstIcon="{{firstIcon2}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" /><mx-input styleType="horizontal" label="自定义图标" lastIcon="{{lastIcon}}" bind:input_change="inputChange" bind:input_lastIcon="handleLastIcon" /><mx-input styleType="horizontal" label="自定义图片" lastIcon="{{lastIcon2}}" bind:input_change="inputChange" bind:input_lastIcon="handleLastIcon" /><mx-input styleType="horizontal" label="极限样式" required firstIcon="{{firstIcon}}" lastIcon="{{lastIcon}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" bind:input_lastIcon="handleLastIcon" /><mx-input styleType="horizontal" label="极限样式" required requiredPosition="left" firstIcon="{{firstIcon}}" lastIcon="{{lastIcon}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" bind:input_lastIcon="handleLastIcon" /><mx-input styleType="horizontal" label="输入框右对齐" inputAlign="right" bind:input_change="inputChange" /><mx-input styleType="horizontal" label="输入框右对齐" value="纳兰忱" inputAlign="right" bind:input_change="inputChange" /><mx-input styleType="horizontal" label="左侧宽度自定义" leftWidth="280" bind:input_change="inputChange" /><mx-input styleType="horizontal" label="标签文本" desc="这是描述内容哦" bind:input_change="inputChange" /><mx-input styleType="horizontal" label="标签文本" desc="这是错误提示信息" descColor="#f00" bind:input_change="inputChange" /></wrap><wrap><title type="h2">样式三：vertical</title><mx-input styleType="vertical" label="标签文本" bind:input_change="inputChange" /><mx-input styleType="vertical" label="标签文本" labelColor="#1677FF" bind:input_change="inputChange" /><mx-input styleType="vertical" label="标签文本" placeholder="请输入内容" placeholderColor="#f00" bind:input_change="inputChange" /><mx-input styleType="vertical" label="标签文本" value="禁用" disabled bind:input_change="inputChange" /><mx-input styleType="vertical" label="标签文本" required bind:input_change="inputChange" /><mx-input styleType="vertical" label="标签文本" required requiredPosition="left" bind:input_change="inputChange" /><mx-input styleType="vertical" label="自定义图标" firstIcon="{{firstIcon}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" /><mx-input styleType="vertical" label="自定义图片" firstIcon="{{firstIcon2}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" /><mx-input styleType="vertical" label="自定义图标" lastIcon="{{lastIcon}}" bind:input_change="inputChange" bind:input_lastIcon="handleLastIcon" /><mx-input styleType="vertical" label="自定义图片" lastIcon="{{lastIcon2}}" bind:input_change="inputChange" bind:input_lastIcon="handleLastIcon" /><mx-input styleType="vertical" label="极限样式" required firstIcon="{{firstIcon}}" lastIcon="{{lastIcon}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" bind:input_lastIcon="handleLastIcon" /><mx-input styleType="vertical" label="极限样式" required requiredPosition="left" firstIcon="{{firstIcon}}" lastIcon="{{lastIcon}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" bind:input_lastIcon="handleLastIcon" /><mx-input styleType="vertical" label="标签文本" desc="这是描述内容哦" value="纳兰忱" bind:input_change="inputChange" /><mx-input styleType="vertical" label="标签文本" desc="这是错误提示信息" descColor="#f00" bind:input_change="inputChange" /></wrap><wrap><title type="h2">样式四：web风格</title><mx-input styleType="web" label="标签文本" bind:input_change="inputChange" /><mx-input styleType="web" label="标签文本" labelColor="#1677FF" bind:input_change="inputChange" /><mx-input styleType="web" label="标签文本" value="禁用" disabled bind:input_change="inputChange" /><mx-input styleType="web" label="标签文本" required bind:input_change="inputChange" /><mx-input styleType="web" label="标签文本" required requiredPosition="left" bind:input_change="inputChange" /><mx-input styleType="web" label="光标颜色" cursorColor="#1677FF" bind:input_change="inputChange" /><mx-input styleType="web" label="自定义图标" firstIcon="{{firstIcon}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" /><mx-input styleType="web" label="自定义图片" firstIcon="{{firstIcon2}}" bind:input_change="inputChange" bind:input_firstIcon="handleFirstIcon" /><mx-input 