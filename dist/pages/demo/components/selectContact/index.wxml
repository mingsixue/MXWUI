<view class="pageDemo"><mx-nav title="选人" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="SelectContact">SelectContact</desc><desc>选人能力：推荐联系人、字母索引通讯录与搜索找人。</desc></view><wrap><title type="h2">基本使用</title><desc type="prop" text="recommendList">recommendList</desc><desc type="prop" text="contactList">contactList</desc><desc type="prop" text="bind:select_contact_select">bind:select_contact_select</desc><view class="contactDemoBox"><mx-select-contact recommendList="{{recommendList}}" contactList="{{contactList}}" height="720rpx" bind:select_contact_select="handleSelect" /></view><view wx:if="{{selectedName}}" class="selectedTip">已选择：{{selectedName}}</view></wrap><wrap><title type="h2">仅全部联系人</title><desc>不传 recommendList 时仅展示通讯录分组。</desc><view class="contactDemoBox"><mx-select-contact contactList="{{shortContacts}}" height="560rpx" bind:select_contact_select="handleSelect" /></view></wrap><wrap><title type="h2">本地搜索</title><desc type="prop" text="localSearch">localSearch</desc><desc type="value" text="true">默认 true，组件内过滤并高亮</desc><view class="contactDemoBox"><mx-select-contact recommendList="{{recommendList}}" contactList="{{shortContacts}}" height="560rpx" localSearch bind:select_contact_select="handleSelect" bind:select_contact_cancel="handleCancel" /></view></wrap><wrap><title type="h2">外部搜索</title><desc type="prop" text="localSearch">localSearch=false</desc><desc type="prop" text="searchResult">searchResult</desc><desc type="prop" text="bind:select_contact_search">bind:select_contact_search</desc><view class="contactDemoBox"><mx-select-contact recommendList="{{recommendList}}" contactList="{{shortContacts}}" height="560rpx" localSearch="{{false}}" searching="{{remoteSearching}}" searchResult="{{remoteSearchResult}}" bind:select_contact_search="handleRemoteSearch" bind:select_contact_select="handleSelect" /></view></wrap><wrap><title type="h2">加载中</title><desc type="prop" text="loading">loading</desc><view class="contactDemoBox"><mx-select-contact loading="{{loading}}" recommendList="{{recommendList}}" contactList="{{shortContacts}}" height="360rpx" /></view></wrap><wrap><title type="h2">空状态</title><desc type="prop" text="emptyText">emptyText</desc><view class="contactDemoBox"><mx-select-contact recommendList="{{emptyList}}" contactList="{{emptyList}}" emptyText="暂无好友，去添加吧" height="360rpx" /></view></wrap><wrap><title type="h2">自定义文案 / 高亮色</title><desc type="prop" text="placeholder">placeholder</desc><desc type="prop" text="highlightColor">highlightColor</desc><desc type="prop" text="recommendTitle">recommendTitle</desc><view class="contactDemoBox"><mx-select-contact recommendList="{{recommendList}}" contactList="{{shortContacts}}" height="560rpx" placeholder="搜姓名 / 手机号" recommendTitle="常联系" contactTitle="通讯录" highlightColor="#1677FF" bind:select_contact_select="handleSelect" /></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 