<view class="pageDemo"><mx-nav title="搜索" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Search">Search</desc><desc>搜索场景的输入框组件，在信息池中缩小范围，快速而轻松地获取目标信息。</desc></view><wrap><title type="h2">搜索栏样式</title><desc type="prop" text="styleType">styleType</desc><desc type="value" text="normal / insert">normal / insert</desc><mx-search styleType="normal" bind:search_change="handleChange" /><line /><mx-search styleType="insert" bind:search_change="handleChange" /></wrap><wrap><title type="h2">值</title><desc type="prop" text="value">value</desc><mx-search styleType="normal" value="纳兰忱" bind:search_change="handleChange" /><line /><mx-search styleType="insert" value="纳兰忱" bind:search_change="handleChange" /></wrap><wrap><title type="h2">是否显示搜索图标</title><desc type="prop" text="showSearchIcon">showSearchIcon</desc><desc type="value" text="是否显示搜索图标">是否显示搜索图标</desc><desc type="prop" text="searchIconColor">searchIconColor</desc><desc type="value" text="搜索图标颜色">搜索图标颜色</desc><desc type="prop" text="searchIconSize">searchIconSize</desc><desc type="value" text="搜索图标大小，默认48">搜索图标大小，默认48</desc><mx-search showSearchIcon="{{true}}" bind:search_change="handleChange" /><line /><mx-search showSearchIcon="{{true}}" searchIconColor="#f00" bind:search_change="handleChange" /><line /><mx-search showSearchIcon="{{true}}" searchIconSize="40" bind:search_change="handleChange" /><line /><mx-search showSearchIcon="{{false}}" bind:search_change="handleChange" /></wrap><wrap><title type="h2">占位文本</title><desc type="prop" text="placeholder">placeholder</desc><desc type="value" text='默认"请输入"'>默认"请输入"</desc><desc type="prop" text="placeholderColor">placeholderColor</desc><desc type="value" text="占位文本颜色">占位文本颜色</desc><mx-search placeholder="请输入关键词" bind:search_change="handleChange" /><line /><mx-search placeholder="请输入关键词" placeholderColor="#f00" bind:search_change="handleChange" /></wrap><wrap><title type="h2">光标颜色</title><desc type="prop" text="cursorColor">cursorColor</desc><mx-search cursorColor="#1677FF" bind:search_change="handleChange" /></wrap><wrap><title type="h2">是否显示清除按钮</title><desc type="prop" text="showClear">showClear</desc><mx-search value="纳兰忱" showClear="{{true}}" bind:search_change="handleChange" /><line /><mx-search value="纳兰忱" showClear="{{false}}" bind:search_change="handleChange" /></wrap><wrap><title type="h2">是否显示按钮</title><desc type="prop" text="showBtn">showBtn</desc><desc type="value" text="是否显示按钮">是否显示按钮</desc><desc type="prop" text="btnText">btnText</desc><desc type="value" text='按钮文案，默认"搜索"'>按钮文案，默认"搜索"</desc><desc type="prop" text="btnColor">btnColor</desc><desc type="value" text="按钮文本色">按钮文本色</desc><mx-search styleType="normal" showBtn="{{true}}" bind:search_change="handleChange" /><line /><mx-search styleType="normal" showBtn="{{true}}" btnText="取消" btnColor="#1677FF" bind:search_change="handleChange" /><line /><mx-search styleType="insert" showBtn="{{true}}" bind:search_change="handleChange" /><line /><mx-search styleType="insert" showBtn="{{true}}" btnText="取消" btnColor="#1677FF" bind:search_change="handleChange" /></wrap><wrap><title type="h2">搜索栏背景色</title><desc type="prop" text="bgColor">bgColor</desc><mx-search styleType="normal" showBtn="{{true}}" bgColor="#c0daff" bind:search_change="handleChange" /><line /><mx-search styleType="insert" showBtn="{{true}}" bgColor="#c0daff" bind:search_change="handleChange" /></wrap><wrap><title type="h2">预设关键词</title><desc type="prop" text="keyword">keyword</desc><desc type="value" text="关键词文本">关键词文本</desc><desc type="prop" text="keywordBgColor">keywordBgColor</desc><desc type="value" text="预设关键词背景色">预设关键词背景色</desc><desc type="prop" text="keywordColor">keywordColor</desc><desc type="value" text="预设关键词文本色">预设关键词文本色</desc><mx-search styleType="normal" showBtn="{{true}}" keyword="手机" bind:search_change="handleChange" /><line /><mx-search styleType="normal" showBtn="{{true}}" keyword="手机" keywordBgColor="#c0daff" keywordColor="#f00" bind:search_change="handleChange" /><line /><view class="bg"><mx-search styleType="insert" showBtn="{{true}}" keyword="手机" bind:search_change="handleChange" /></view><line /><view class="bg"><mx-search styleType="insert" showBtn="{{true}}" keyword="手机" keywordBgColor="#c0daff" keywordColor="#f00" bind:search_change="handleChange" /></view></wrap><wrap><title type="h2">是否显示返回按钮</title><desc type="prop" text="showBack">showBack</desc><desc type="value" text="是否显示返回按钮">是否显示返回按钮</desc><desc type="prop" text="backColor">backColor</desc><desc type="value" text="返回图标颜色">返回图标颜色</desc><mx-search styleType="normal" showBack="{{true}}" bind:search_change="handleChange" /><line /><mx-search styleType="normal" showBack="{{true}}" backColor="#f00" bind:search_change="handleChange" /></wrap><wrap><title type="h2">事件</title><desc type="prop" text="bind:search_change">bind:search_change</desc><desc type="value" text="值变更事件">值变更事件</desc><desc type="prop" text="bind:search_back">bind:search_back</desc><desc type="value" text="返回按钮点击事件">返回按钮点击事件</desc><mx-search styleType="normal" showBtn="{{true}}" showBack="{{true}}" bind:search_change="handleChange" bind:search_back="handleBack" /></wrap><prop-table dataSource="{{propDocs}}" /></view>