<view class="pageDemo"><mx-nav title="气泡弹出框" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Popover">Popover</desc><desc>点击元素，弹出气泡式的菜单或提示。</desc><desc>用于导航功能的气泡菜单唤起，或展示轻量提示信息。</desc></view><wrap><title type="h2">基本用法</title><desc type="prop" text="content">content</desc><desc type="value" text="气泡内容文案">气泡内容文案</desc><desc type="prop" text="placement">placement</desc><desc type="value" text="默认 top">默认 top</desc><view class="popoverDemo"><mx-popover content="简单的气泡提示" placement="top"><mx-btn width="160rpx" small>点我</mx-btn></mx-popover></view></wrap><wrap><title type="h2">深色 / 浅色</title><desc type="prop" text="color">color</desc><desc type="prop" text="textColor">textColor</desc><view class="popoverDemoRow"><mx-popover content="Hello World" placement="bottom" visible="{{visibleDark}}" bind:popover_visible_change="handleDarkChange" ><mx-btn width="160rpx" small>深色</mx-btn></mx-popover><mx-popover content="Hello World" placement="bottom" color="#FFFFFF" textColor="#040A23" visible="{{visibleLight}}" bind:popover_visible_change="handleLightChange" ><mx-btn width="160rpx" small>浅色</mx-btn></mx-popover></view></wrap><wrap><title type="h2">气泡位置</title><desc type="prop" text="placement">placement</desc><desc type="value" text="当前：{{placement}}">当前：{{placement}}</desc><desc>可选 top / top-left / top-right / bottom / bottom-left / bottom-right / left / left-top / left-bottom / right / right-top / right-bottom</desc><view class="popoverDemoCenter"><mx-popover content="当前方向：{{placement}}" placement="{{placement}}" visible="{{visible}}" showMask="{{false}}" bind:popover_visible_change="handleVisibleChange" ><view class="placementBox"><view>当前方向</view><view class="placementTip">{{placement}}</view></view></mx-popover></view><view class="popoverAction"><mx-btn width="240rpx" small bind:btn_tap="handleNextPlacement">下一个方向</mx-btn></view></wrap><wrap><title type="h2">受控显示</title><desc type="prop" text="visible">visible</desc><desc type="value" text="{{visible}}">{{visible}}</desc><desc type="prop" text="bind:popover_visible_change">bind:popover_visible_change</desc><view class="popoverDemo"><mx-popover content="受控气泡" placement="right" showMask="{{false}}" visible="{{visible}}" bind:popover_visible_change="handleVisibleChange" ><text class="popoverText">外部按钮控制显隐</text></mx-popover></view><view class="popoverAction"><mx-btn width="220rpx" small bind:btn_tap="handleToggleVisible">切换 visible</mx-btn></view></wrap><wrap><title type="h2">自定义颜色</title><desc type="prop" text="color">color</desc><desc type="prop" text="textColor">textColor</desc><view class="popoverDemoRow"><mx-popover content="主题色气泡" color="#CA0E2D" placement="top" visible="{{visibleCustom}}" bind:popover_visible_change="handleCustomChange" ><mx-btn width="180rpx" small>主题色</mx-btn></mx-popover><mx-popover content="绿色气泡" color="#098562" placement="top"><mx-btn width="180rpx" small>绿色</mx-btn></mx-popover></view></wrap><wrap><title type="h2">自定义内容插槽</title><desc type="prop" text="slot=content">slot="content"</desc><view class="popoverDemo"><mx-popover placement="bottom" visible="{{visibleSlot}}" bind:popover_visible_change="handleSlotChange" ><mx-btn width="180rpx" small>自定义内容</mx-btn><view slot="content" class="slotContent"><mx-icon name="remind" color="#FFFFFF" size="36" /><text class="slotText">可放图标、按钮等自定义内容</text></view></mx-popover></view></wrap><wrap><title type="h2">关闭蒙层</title><desc type="prop" text="showMask">showMask</desc><desc type="value" text="false 时点击空白不关闭">false 时点击空白不关闭</desc><view class="popoverDemo"><mx-popover content="无蒙层，点触发器切换" placement="top" showMask="{{false}}" defaultVisible><mx-btn width="200rpx" small>无蒙层</mx-btn></mx-popover></view></wrap><wrap><title type="h2">自动调整位置</title><desc type="prop" text="autoAdjustOverflow">autoAdjustOverflow</desc><desc type="value" text="默认 true，靠近边缘时自动翻转">默认 true，靠近边缘时自动翻转</desc><view class="popoverDemoEdge"><mx-popover content="空间不足时会自动调整到下方" placement="top"><mx-btn width="220rpx" small>靠近顶部</mx-btn></mx-popover></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 