.pageDemo{min-height:100vh;padding-bottom:48rpx;padding-bottom:calc(constant(safe-area-inset-bottom) + 48rpx);padding-bottom:calc(env(safe-area-inset-bottom) + 48rpx);background:#f8f9fa;box-sizing:border-box}.demoIntro{position:relative;padding:32rpx 0 20rpx;margin-bottom:8rpx}.demoIntro::before{content:'';position:absolute;left:0;right:0;top:0;bottom:0;z-index:0;background:radial-gradient(ellipse 80% 90% at 0 0,rgba(202,14,45,.1) 0,transparent 55%),linear-gradient(180deg,#fff 0,#f8f9fa 100%);pointer-events:none}.demoIntro>desc,.demoIntro>title,.demoIntro>view{position:relative;z-index:1}.cons{display:flex;flex-wrap:wrap;align-items:center;margin:8rpx 48rpx 16rpx}.cons .space{display:inline-block;width:24rpx}.popoverDemo{margin:24rpx 48rpx 8rpx;display:flex;justify-content:center}.popoverDemoRow{margin:24rpx 48rpx 8rpx;display:flex;align-items:center;justify-content:space-around}.popoverDemoCenter{margin:80rpx 48rpx;display:flex;justify-content:center;align-items:center;min-height:240rpx}.popoverDemoEdge{margin:8rpx 48rpx 24rpx;display:flex;justify-content:flex-start}.placementBox{width:240rpx;height:240rpx;border-radius:16rpx;background:#f4f6f7;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:28rpx;color:#040a23;box-sizing:border-box}.placementTip{margin-top:12rpx;font-size:24rpx;color:#ca0e2d}.popoverAction{margin:16rpx 48rpx 8rpx;display:flex;justify-content:center}.popoverText{font-size:28rpx;color:#656979}.slotContent{display:flex;align-items:center}.slotText{margin-left:12rpx;max-width:320rpx}