<view class="pageDemo"><mx-nav title="底部基础弹窗" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="DialogBottom">DialogBottom</desc><desc>由底部出现的弹出层容器，用于展示弹窗、信息提示等内容。</desc></view><wrap><title type="h2">是否显示弹窗</title><desc type="prop" text="visible">visible</desc><mx-dialog-bottom visible="{{visible}}" bind:dialog_bottom_close="handleClose"></mx-dialog-bottom><view class="cons"><mx-btn width="130rpx" small bind:btn_tap="handleVisible">查看</mx-btn></view></wrap><wrap><title type="h2">是否显示关闭按钮</title><desc type="prop" text="showClose">showClose</desc><mx-dialog-bottom visible="{{visibleShowClose}}" showClose="{{false}}"></mx-dialog-bottom><view class="cons"><mx-btn width="140rpx" small bind:btn_tap="handleShowClose">不显示</mx-btn></view></wrap><wrap><title type="h2">层级</title><desc type="prop" text="zIndex">zIndex</desc><mx-dialog-bottom visible="{{false}}" zIndex="1"></mx-dialog-bottom></wrap><wrap><title type="h2">蒙层是否可以关闭弹窗</title><desc type="prop" text="isCloseMask">isCloseMask</desc><mx-dialog-bottom visible="{{visibleMaskClose}}" isCloseMask="{{false}}"></mx-dialog-bottom><view class="cons"><mx-btn width="200rpx" small bind:btn_tap="handleMaskClose">蒙层不可关闭</mx-btn></view></wrap><wrap><title type="h2">自定义高度</title><desc type="prop" text="height">height</desc><mx-dialog-bottom visible="{{false}}" height="70vh"></mx-dialog-bottom></wrap><wrap><title type="h2">事件</title><desc type="prop" text="bind">bind</desc><desc type="value" text="dialog_basic_close，关闭弹窗回调事件">dialog_basic_close，关闭弹窗回调事件</desc><mx-dialog-bottom visible="{{visibleHandle}}" bind:dialog_bottom_close="handleClose"></mx-dialog-bottom><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleHandle">事件</mx-btn></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view>