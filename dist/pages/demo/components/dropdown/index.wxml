<view class="pageDemo"><mx-nav title="下拉菜单" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Dropdown">Dropdown</desc><desc>点击触发器弹出的下拉菜单，用于操作列表、更多功能入口等场景。</desc></view><wrap><title type="h2">基础用法</title><desc type="prop" text="options">options</desc><desc type="prop" text="bind:dropdown_select">bind:dropdown_select</desc><desc type="value" text="当前选择：{{selectedText || '无'}}">当前选择：{{selectedText || '无'}}</desc><view class="dropdownDemo"><mx-dropdown options="{{options}}" bind:dropdown_select="handleSelect"><mx-btn width="180rpx" small>更多操作</mx-btn></mx-dropdown></view></wrap><wrap><title type="h2">带图标</title><desc type="prop" text="options[x].iconName">options[x].iconName</desc><desc type="prop" text="options[x].iconColor">options[x].iconColor</desc><view class="dropdownDemo"><mx-dropdown options="{{optionsIcon}}" visible="{{visibleIcon}}" bind:dropdown_visible_change="handleIconChange" bind:dropdown_select="handleSelect" ><mx-btn width="180rpx" small>图标菜单</mx-btn></mx-dropdown></view></wrap><wrap><title type="h2">禁用项 / 分割线</title><desc type="prop" text="options[x].disabled">options[x].disabled</desc><desc type="prop" text="options[x].divided">options[x].divided</desc><view class="dropdownDemoRow"><mx-dropdown options="{{optionsDisabled}}" visible="{{visibleDisabled}}" bind:dropdown_visible_change="handleDisabledChange" bind:dropdown_select="handleSelect" ><mx-btn width="160rpx" small>禁用项</mx-btn></mx-dropdown><mx-dropdown options="{{options}}" bind:dropdown_select="handleSelect"><mx-btn width="160rpx" small>分割线</mx-btn></mx-dropdown></view></wrap><wrap><title type="h2">自定义文本色</title><desc type="prop" text="options[x].color">options[x].color</desc><view class="dropdownDemo"><mx-dropdown options="{{optionsColor}}" visible="{{visibleColor}}" bind:dropdown_visible_change="handleColorChange" bind:dropdown_select="handleSelect" ><mx-btn width="180rpx" small>彩色菜单</mx-btn></mx-dropdown></view></wrap><wrap><title type="h2">弹出位置</title><desc type="prop" text="placement">placement</desc><desc type="value" text="当前：{{placement}}">当前：{{placement}}</desc><desc>可选 bottom-left / bottom / bottom-right / top-left / top / top-right</desc><view class="dropdownDemoCenter"><mx-dropdown options="{{options}}" placement="{{placement}}" visible="{{visiblePlacement}}" showMask="{{false}}" bind:dropdown_visible_change="handlePlacementChange" bind:dropdown_select="handleSelect" ><view class="placementBox"><view>当前方向</view><view class="placementTip">{{placement}}</view></view></mx-dropdown></view><view class="dropdownAction"><mx-btn width="240rpx" small bind:btn_tap="handleNextPlacement">下一个方向</mx-btn></view></wrap><wrap><title type="h2">受控显示</title><desc type="prop" text="visible">visible</desc><desc type="value" text="{{visible}}">{{visible}}</desc><desc type="prop" text="bind:dropdown_visible_change">bind:dropdown_visible_change</desc><view class="dropdownDemo"><mx-dropdown options="{{options}}" placement="bottom" showMask="{{false}}" visible="{{visible}}" bind:dropdown_visible_change="handleVisibleChange" bind:dropdown_select="handleSelect" ><text class="dropdownText">外部按钮控制显隐</text></mx-dropdown></view><view class="dropdownAction"><mx-btn width="220rpx" small bind:btn_tap="handleToggleVisible">切换 visible</mx-btn></view></wrap><wrap><title type="h2">菜单宽度</title><desc type="prop" text="menuWidth">menuWidth</desc><desc type="value" text="280">280</desc><view class="dropdownDemo"><mx-dropdown options="{{options}}" menuWidth="{{280}}" visible="{{visibleWidth}}" bind:dropdown_visible_change="handleWidthChange" bind:dropdown_select="handleSelect" ><mx-btn width="180rpx" small>固定宽度</mx-btn></mx-dropdown></view></wrap><wrap><title type="h2">自定义菜单插槽</title><desc type="prop" text="slot=menu">slot="menu"</desc><view class="dropdownDemo"><mx-dropdown placement="bottom-left" visible="{{visibleSlot}}" bind:dropdown_visible_change="handleSlotChange" ><mx-btn width="180rpx" small>自定义菜单</mx-btn><view slot="menu" class="slotMenu"><view class="slotItem" data-name="复制链接" catch:tap="handleSlotAction">复制链接</view><view class="slotItem" data-name="生成海报" catch:tap="handleSlotAction">生成海报</view><view class="slotItem slotDanger" data-name="举报" catch:tap="handleSlotAction">举报</view></view></mx-dropdown></view></wrap><wrap><title type="h2">关闭蒙层</title><desc type="prop" text="showMask">showMask</desc><desc type="value" text="false 时点击空白不关闭">false 时点击空白不关闭</desc><view class="dropdownDemo"><mx-dropdown options="{{options}}" showMask="{{false}}" bind:dropdown_select="handleSelect"><mx-btn width="200rpx" small>无蒙层</mx-btn></mx-dropdown></view></wrap><wrap><title type="h2">选中后不关闭</title><desc type="prop" text="closeOnSelect">closeOnSelect</desc><desc type="value" text="false">false</desc><view class="dropdownDemo"><mx-dropdown options="{{options}}" closeOnSelect="{{false}}" bind:dropdown_select="handleSelect"><mx-btn width="220rpx" small>保持打开</mx-btn></mx-dropdown></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 