.demoPropTable{margin:56rpx 24rpx 24rpx;overflow:hidden;background:#fff;border-radius:20rpx;border:1rpx solid #e1e5ec;box-sizing:border-box}.demoPropTable-hd{display:flex;align-items:flex-start;padding:28rpx 28rpx 24rpx;background:linear-gradient(135deg,rgba(202,14,45,.06) 0,#f4f6f7 48%,#fff 100%);border-bottom:1rpx solid #e1e5ec;box-sizing:border-box}.demoPropTable-badge{flex-shrink:0;margin-right:20rpx;margin-top:4rpx;padding:4rpx 14rpx;border-radius:8rpx;background:#ca0e2d;color:#fff;font-size:20rpx;font-weight:600;letter-spacing:1rpx;line-height:1.4;font-family:Menlo,Monaco,Consolas,'Courier New',monospace}.demoPropTable-hdMain{flex:1;min-width:0}.demoPropTable-title{font-size:30rpx;font-weight:700;color:#040a23;line-height:1.35;letter-spacing:.5rpx}.demoPropTable-sub{margin-top:8rpx;font-size:22rpx;font-weight:400;color:#656979;line-height:1.5}.demoPropTable-body{width:100%;overflow:hidden;background:#fff}