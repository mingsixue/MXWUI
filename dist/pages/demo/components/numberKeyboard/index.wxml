<view class="pageDemo"><mx-nav title="数字键盘" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="NumberKeyboard">NumberKeyboard</desc><desc>自定义数字键盘，适用于金额、验证码、密码、身份证号等数字输入场景。</desc></view><wrap><title type="h2">是否显示</title><desc type="prop" text="visible">visible</desc><desc type="prop" text="value">value</desc><view class="valueBox">当前值：{{value || '空'}}</view><view class="cons"><mx-btn width="140rpx" small bind:btn_tap="handleVisible">打开键盘</mx-btn></view><mx-number-keyboard visible="{{visible}}" value="{{value}}" bind:number_keyboard_change="onChange" bind:number_keyboard_close="onClose" /></wrap><wrap><title type="h2">没有小数点</title><desc type="prop" text="point">point</desc><view class="valueBox">当前值：{{valuePoint || '空'}}</view><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handlePoint">无小数点键盘</mx-btn></view><mx-number-keyboard visible="{{visiblePoint}}" value="{{valuePoint}}" point="{{false}}" bind:number_keyboard_change="onChangePoint" bind:number_keyboard_close="onClosePoint" /></wrap><wrap><title type="h2">身份证号模式</title><desc type="prop" text="mode">mode</desc><desc type="value" text="idcard">idcard</desc><view class="valueBox">当前值：{{valueIdcard || '空'}}</view><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleIdcard">身份证键盘</mx-btn></view><mx-number-keyboard visible="{{visibleIdcard}}" value="{{valueIdcard}}" mode="idcard" closeable bind:number_keyboard_change="onChangeIdcard" bind:number_keyboard_close="onCloseIdcard" ><view slot="header" class="customHeader">请输入身份证号</view></mx-number-keyboard></wrap><wrap><title type="h2">带确认按钮</title><desc type="prop" text="confirmText">confirmText</desc><desc type="prop" text="confirmColor">confirmColor</desc><view class="valueBox">当前值：{{valueConfirm || '空'}}</view><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleConfirm">确认按钮键盘</mx-btn></view><mx-number-keyboard visible="{{visibleConfirm}}" value="{{valueConfirm}}" confirmText="确认" confirmColor="#1677FF" bind:number_keyboard_change="onChangeConfirm" bind:number_keyboard_confirm="onConfirmConfirm" bind:number_keyboard_close="onCloseConfirm" /></wrap><wrap><title type="h2">带关闭箭头</title><desc type="prop" text="closeable">closeable</desc><view class="valueBox">当前值：{{valueCloseable || '空'}}</view><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleCloseable">关闭箭头键盘</mx-btn></view><mx-number-keyboard visible="{{visibleCloseable}}" value="{{valueCloseable}}" closeable bind:number_keyboard_change="onChangeCloseable" bind:number_keyboard_close="onCloseCloseable" /></wrap><wrap><title type="h2">乱序键盘</title><desc type="prop" text="random">random</desc><view class="valueBox">当前值：{{valueRandom || '空'}}</view><view class="cons"><mx-btn width="140rpx" small bind:btn_tap="handleRandom">乱序键盘</mx-btn></view><mx-number-keyboard visible="{{visibleRandom}}" value="{{valueRandom}}" random closeable bind:number_keyboard_change="onChangeRandom" bind:number_keyboard_close="onCloseRandom" /></wrap><wrap><title type="h2">自定义标题栏</title><desc type="prop" text="slot:header">slot:header</desc><view class="valueBox">当前值：{{valueHeader || '空'}}</view><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleHeader">自定义标题</mx-btn></view><mx-number-keyboard visible="{{visibleHeader}}" value="{{valueHeader}}" bind:number_keyboard_change="onChangeHeader" bind:number_keyboard_close="onCloseHeader" ><view slot="header" class="customHeader">请输入金额</view></mx-number-keyboard></wrap><wrap><title type="h2">禁用确认按钮</title><desc type="prop" text="confirmDisabled">confirmDisabled</desc><view class="valueBox">当前值：{{valueDisabled || '空'}}</view><view class="cons"><mx-btn width="200rpx" small bind:btn_tap="handleDisabled">禁用确认按钮</mx-btn></view><mx-number-keyboard visible="{{visibleDisabled}}" value="{{valueDisabled}}" confirmText="提交" confirmDisabled="{{confirmDisabled}}" bind:number_keyboard_change="onChangeDisabled" bind:number_keyboard_confirm="onConfirmDisabled" bind:number_keyboard_close="onCloseDisabled" /></wrap><wrap><title type="h2">事件</title><desc type="prop" text="bind:number_keyboard_change">bind:number_keyboard_change</desc><desc type="value" text="输入变化回调">输入变化回调</desc><desc type="prop" text="bind:number_keyboard_confirm">bind:number_keyboard_confirm</desc><desc type="value" text="点击确认回调">点击确认回调</desc><desc type="prop" text="bind:number_keyboard_close">bind:number_keyboard_close</desc><desc type="value" text="键盘关闭回调">键盘关闭回调</desc><view class="valueBox">当前值：{{valueEvent || '空'}}</view><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleEvent">事件</mx-btn></view><mx-number-keyboard visible="{{visibleEvent}}" value="{{valueEvent}}" confirmText="完成" closeable bind:number_keyboard_change="onChangeEvent" bind:number_keyboard_confirm="onConfirmEvent" bind:number_keyboard_close="onCloseEvent" /></wrap><prop-table dataSource="{{propDocs}}" /></view> 