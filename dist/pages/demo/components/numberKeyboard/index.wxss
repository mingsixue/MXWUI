.pageDemo{min-height:100vh;padding-bottom:48rpx;padding-bottom:calc(constant(safe-area-inset-bottom) + 48rpx);padding-bottom:calc(env(safe-area-inset-bottom) + 48rpx);background:#f8f9fa;box-sizing:border-box}.demoIntro{position:relative;padding:32rpx 0 20rpx;margin-bottom:8rpx}.demoIntro::before{content:'';position:absolute;left:0;right:0;top:0;bottom:0;z-index:0;background:radial-gradient(ellipse 80% 90% at 0 0,rgba(202,14,45,.1) 0,transparent 55%),linear-gradient(180deg,#fff 0,#f8f9fa 100%);pointer-events:none}.demoIntro>desc,.demoIntro>title,.demoIntro>view{position:relative;z-index:1}.cons{display:flex;flex-wrap:wrap;align-items:center;margin:8rpx 48rpx 16rpx}.cons .space{display:inline-block;width:24rpx}.pageDemo .cons{display:block;margin:8rpx 48rpx 16rpx;padding:24rpx 16rpx}.pageDemo .valueBox{margin:8rpx 48rpx 0;padding:20rpx 24rpx;font-size:28rpx;color:#040a23;background:#f8f9fa;border-radius:12rpx;word-break:break-all}.pageDemo .customHeader{display:flex;align-items:center;justify-content:center;height:88rpx;font-size:28rpx;color:#656979;background:#fff;border-bottom:1rpx solid #eff0f5}