<view class="pageDemo"><mx-nav title="底部文本弹窗" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="DialogText">DialogText</desc><desc>由底部出现的展示弹窗，展示基本的文本和按钮。</desc></view><wrap><title type="h2">是否显示弹窗</title><desc type="prop" text="visible">visible</desc><mx-dialog-text visible="{{visible}}" title="标题" content="这是内容哦这是内容哦这是内容哦" bind:dialog_text_main="handleClickMain" bind:dialog_text_close="handleClickClose" /><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleVisible">查看</mx-btn></view></wrap><wrap><title type="h2">标题</title><desc type="prop" text="title">title</desc><desc type="prop" text="titleColor">titleColor</desc><mx-dialog-text visible="{{visibleTitle}}" title="自定义标题" titleColor="{{titleColor}}" bind:dialog_text_main="handleClickMain" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleTitle">设置标题</mx-btn><view class="space"></view><mx-btn width="180rpx" small bind:btn_tap="handleTitleColor">标题文本色</mx-btn></view></wrap><wrap><title type="h2">内容</title><desc type="prop" text="content">content</desc><desc type="prop" text="contentColor">contentColor</desc><mx-dialog-text visible="{{visibleContent}}" content="内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容内容" contentColor="{{contentColor}}" bind:dialog_text_main="handleClickMain"></mx-dialog-text><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleContent">设置内容</mx-btn><view class="space"></view><mx-btn width="180rpx" small bind:btn_tap="handleContentColor">内容文本色</mx-btn></view></wrap><wrap><title type="h2">自定义内容</title><desc>使用slot方式</desc><mx-dialog-text visible="{{visibleContent2}}" title="自定义内容" bind:dialog_text_main="handleClickMain"><view style="height: 300px;background: rgba(0,0,255,.2);">// 自定义内容及样式</view></mx-dialog-text><view class="cons"><mx-btn width="180rpx" small bind:btn_tap="handleContent2">自定义内容</mx-btn></view></wrap><wrap><title type="h2">主按钮</title><desc type="prop" text="mainBtnText">mainBtnText</desc><desc type="prop" text="mainBtnColor">mainBtnColor</desc><mx-dialog-text visible="{{visibleMain}}" title="自定义主按钮" mainBtnText="主按钮" mainBtnColor="#1677FF" bind:dialog_text_main="handleClickMain"></mx-dialog-text><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleMain">主按钮</mx-btn></view></wrap><wrap><title type="h2">是否显示辅助按钮</title><desc type="prop" text="showMinor">showMinor</desc><mx-dialog-text visible="{{visibleShowMinor}}" title="标题" showMinor="{{true}}" bind:dialog_text_main="handleClickMain" bind:dialog_text_minor="handleClickMinor"></mx-dialog-text><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleShowMinor">辅助按钮</mx-btn></view></wrap><wrap><title type="h2">辅助按钮</title><desc type="prop" text="minorBtnText">minorBtnText</desc><desc type="prop" text="minorBtnColor">minorBtnColor</desc><mx-dialog-text visible="{{visibleMinor}}" title="自定义辅助按钮" showMinor="{{true}}" minorBtnText="辅助按钮" minorBtnColor="#1677FF" bind:dialog_text_main="handleClickMain" bind:dialog_text_minor="handleClickMinor"></mx-dialog-text><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleMinor">辅助按钮</mx-btn></view></wrap><wrap><title type="h2">层级</title><desc type="prop" text="zIndex">zIndex</desc><mx-dialog-text visible="{{false}}" zIndex="1"></mx-dialog-text></wrap><wrap><title type="h2">点击蒙层是否可以关闭弹窗</title><desc type="prop" text="isCloseMask">isCloseMask</desc><mx-dialog-text visible="{{visibleMaskClose}}" isCloseMask="{{false}}" bind:dialog_text_main="handleClickMain"></mx-dialog-text><view class="cons"><mx-btn width="200rpx" small bind:btn_tap="handleMaskClose">蒙层不可关闭</mx-btn></view></wrap><wrap><title type="h2">事件</title><desc type="prop" text="bind:dialog_text_close">bind:dialog_text_close</desc><desc type="value" text="弹窗关闭">弹窗关闭</desc><desc type="prop" text="bind:dialog_text_main">bind:dialog_text_main</desc><desc type="value" text="主按钮点击">主按钮点击</desc><desc type="prop" text="bind:dialog_text_minor">bind:dialog_text_minor</desc><