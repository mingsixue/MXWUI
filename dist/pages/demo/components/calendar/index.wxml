<view class="pageDemo"><mx-nav title="日历" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Calendar">Calendar</desc><desc>适用于需要日期选择的场景</desc></view><wrap><title type="h2">是否显示</title><desc type="prop" text="visible">visible</desc><mx-calendar visible="{{visible}}" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisible">查看日历</mx-btn></view></wrap><wrap><title type="h2">选择模式</title><desc type="prop" text="selectionMode">selectionMode</desc><desc type="value" text="single 单个日期选择 / range 日期段">single 单个日期选择 / range 日期段</desc><mx-calendar visible="{{visibleMode}}" selectionMode="range" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleMode">查看日历</mx-btn></view></wrap><wrap><title type="h2">初始日期</title><desc type="prop" text="defaultValue">defaultValue</desc><desc type="value" text="格式 YYYY-MM-DD，selectionMode=single有效">格式 YYYY-MM-DD，selectionMode=single有效</desc><mx-calendar visible="{{visibleValue}}" defaultValue="2024-05-20" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleValue">查看日历</mx-btn></view></wrap><wrap><title type="h2">开始日期/结束日期</title><desc type="prop" text="startDate">startDate</desc><desc type="value" text="格式 YYYY-MM-DD，selectionMode=range有效">格式 YYYY-MM-DD，selectionMode=range有效</desc><desc type="prop" text="endDate">endDate</desc><desc type="value" text="格式 YYYY-MM-DD，selectionMode=range有效">格式 YYYY-MM-DD，selectionMode=range有效</desc><mx-calendar visible="{{visibleStart}}" selectionMode="range" startDate="2024-12-10" endDate="2024-12-20" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleStart">查看日历</mx-btn></view></wrap><wrap><title type="h2">最小可选日期</title><desc type="prop" text="min">min</desc><desc type="value" text="格式 YYYY-MM-DD">格式 YYYY-MM-DD</desc><mx-calendar visible="{{visibleMin}}" min="2024-12-20" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><mx-calendar visible="{{visibleMin2}}" selectionMode="range" min="2024-12-20" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleMin">单选限制</mx-btn><view class="space"></view><mx-btn width="190rpx" small bind:btn_tap="handleVisibleMin2">日期范围限制</mx-btn></view></wrap><wrap><title type="h2">最大可选日期</title><desc type="prop" text="max">max</desc><desc type="value" text="格式 YYYY-MM-DD">格式 YYYY-MM-DD</desc><mx-calendar visible="{{visibleMax}}" max="2024-12-20" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><mx-calendar visible="{{visibleMax2}}" selectionMode="range" max="2024-12-20" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleMax">单选限制</mx-btn><view class="space"></view><mx-btn width="190rpx" small bind:btn_tap="handleVisibleMax2">日期范围限制</mx-btn></view></wrap><wrap><title type="h2">日期限制</title><mx-calendar visible="{{visibleMinMax}}" min="2024-12-05" max="2024-12-20" showLunar="{{true}}" showFestival="{{true}}" showSolarTerm="{{true}}" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><mx-calendar visible="{{visibleMinMax2}}" selectionMode="range" min="2024-12-05" max="2024-12-20" showLunar="{{true}}" showFestival="{{true}}" showSolarTerm="{{true}}" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="190rpx" small bind:btn_tap="handleVisibleMinMax">最大最小限制</mx-btn><view class="space"></view><mx-btn width="190rpx" small bind:btn_tap="handleVisibleMinMax2">日期范围限制</mx-btn></view></wrap><wrap><title type="h2">第一天是从周一开始还是周日开始</title><desc type="prop" text="weekStartsOn">weekStartsOn</desc><desc type="value" text="Monday / Sunday">Monday / Sunday</desc><mx-calendar visible="{{visibleWeek}}" weekStartsOn="Sunday" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleWeek">查看日历</mx-btn></view></wrap><wrap><title type="h2">是否显示农历</title><desc type="prop" text="showLunar">showLunar</desc><mx-calendar visible="{{visibleLunar}}" showLunar="{{true}}" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleLunar">查看日历</mx-btn></view></wrap><wrap><title type="h2">是否显示二十四节气</title><desc type="prop" text="showSolarTerm">showSolarTerm</desc><mx-calendar visible="{{visibleSolarTerm}}" showSolarTerm="{{true}}" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleSolarTerm">查看日历</mx-btn></view></wrap><wrap><title type="h2">是否显示节日</title><desc type="prop" text="showFestival">showFestival</desc><mx-calendar visible="{{visibleFestival}}" showFestival="{{true}}" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleFestival">查看日历</mx-btn></view></wrap><wrap><title type="h2">显示节日节气农历</title><mx-calendar visible="{{visibleAll}}" showLunar="{{true}}" showFestival="{{true}}" showSolarTerm="{{true}}" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleAll">查看日历</mx-btn></view></wrap><wrap><title type="h2">标题</title><desc type="prop" text="title">title</desc><mx-calendar visible="{{visibleTitle}}" title="日期选择" showLunar="{{true}}" showFestival="{{true}}" showSolarTerm="{{true}}" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleTitle">查看日历</mx-btn></view></wrap><wrap><title type="h2">取消按钮</title><desc type="prop" text="cancelText">cancelText</desc><desc type="value" text="取消按钮文案">取消按钮文案</desc><desc type="prop" text="cancelColor">cancelColor</desc><desc type="value" text="取消按钮文本色">取消按钮文本色</desc><mx-calendar visible="{{visibleCancel}}" cancelText="关闭" cancelColor="#1677FF" showLunar="{{true}}" showFestival="{{true}}" showSolarTerm="{{true}}" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleCancel">查看日历</mx-btn></view></wrap><wrap><title type="h2">确定按钮</title><desc type="prop" text="confirmText">confirmText</desc><desc type="value" text="确定按钮文案">确定按钮文案</desc><desc type="prop" text="confirmColor">confirmColor</desc><desc type="value" text="确定按钮文本色">确定按钮文本色</desc><mx-calendar visible="{{visibleConfirm}}" confirmText="保存" confirmColor="#1677FF" showLunar="{{true}}" showFestival="{{true}}" showSolarTerm="{{true}}" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleConfirm">查看日历</mx-btn></view></wrap><wrap><title type="h2">层级</title><desc type="prop" text="zIndex">zIndex</desc></wrap><wrap><title type="h2">点击蒙层是否可以关闭弹窗</title><desc type="prop" text="isCloseMask">isCloseMask</desc><mx-calendar visible="{{visibleMask}}" isCloseMask="{{false}}" showLunar="{{true}}" showFestival="{{true}}" showSolarTerm="{{true}}" bind:calendar_confirm="handleConfirm" bind:calendar_close="handleClose" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleMask">不关闭</mx-btn></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view>