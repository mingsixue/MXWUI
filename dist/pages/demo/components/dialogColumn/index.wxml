<view class="pageDemo"><mx-nav title="分栏弹窗" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="DialogColumn">DialogColumn</desc><desc>由底部出现的分栏弹窗，存在级联关系。</desc></view><wrap><title type="h2">基础用法</title><mx-dialog-column visible="{{visible}}" options="{{options}}" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><view class="cons"><mx-btn width="140rpx" small bind:btn_tap="handleVisible">查看样式</mx-btn></view></wrap><wrap><title type="h2">是否显示弹窗</title><desc type="prop" text="visible">visible</desc><mx-dialog-column visible="{{false}}" options="{{options}}" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /></wrap><wrap><title type="h2">数据项</title><desc type="prop" text="options">options</desc><desc type="value" text="参数：options[x].label，名称">参数：options[x].label，名称</desc><desc>参数：options[x].value，值</desc><desc>参数：options[x].children，子项列表</desc><desc>参数：options[x].children[x].label，子项名称</desc><desc>参数：options[x].children[x].value，子项值</desc></wrap><wrap><title type="h2">当前选中项</title><desc type="prop" text="current">current</desc><desc type="value" text="当前选中项，默认0，选中第一项">当前选中项，默认0，选中第一项</desc><desc type="prop" text="subCurrent">subCurrent</desc><desc type="value" text="当前选中子项，默认-1，不选择">当前选中子项，默认-1，不选择</desc><mx-dialog-column visible="{{visibleCurrent}}" options="{{options}}" current="2" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><mx-dialog-column visible="{{visibleCurrent2}}" options="{{options}}" current="2" subCurrent="1" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleVisibleCurrent">当前选中项</mx-btn><view class="space"></view><mx-btn width="190rpx" small bind:btn_tap="handleVisibleCurrent2">当前选中子项</mx-btn></view></wrap><wrap><title type="h2">文本色</title><desc type="prop" text="textColor">textColor</desc><desc type="value" text="文本色">文本色</desc><desc type="prop" text="selectColor">selectColor</desc><desc type="value" text="选中项文本色">选中项文本色</desc><mx-dialog-column visible="{{visibleColor}}" options="{{options}}" textColor="#656979" selectColor="#1677FF" subCurrent="1" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleVisibleColor">文本色</mx-btn></view></wrap><wrap><title type="h2">标题</title><desc type="prop" text="title">title</desc><desc type="prop" text="titleColor">titleColor</desc><mx-dialog-column visible="{{visibleTitle}}" showWrapClose="{{false}}" title="标题" titleColor="{{titleColor}}" options="{{options}}" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><view class="cons"><mx-btn width="140rpx" small bind:btn_tap="handleTitle">设置标题</mx-btn><view class="space"></view><mx-btn width="210rpx" small bind:btn_tap="handleTitleColor">自定义标题颜色</mx-btn></view></wrap><wrap><title type="h2">确认按钮</title><desc type="prop" text="confirmText">confirmText</desc><desc type="value" text="确认按钮文案">确认按钮文案</desc><desc type="prop" text="confirmColor">confirmColor</desc><desc type="value" text="确认按钮文本色">确认按钮文本色</desc><mx-dialog-column visible="{{visibleConfirm}}" title="标题" confirmText="完成" confirmColor="#1677FF" options="{{options}}" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><view class="cons"><mx-btn width="240rpx" small bind:btn_tap="handleConfirm">更改文案&文本色</mx-btn></view></wrap><wrap><title type="h2">取消按钮</title><desc type="prop" text="cancelText">cancelText</desc><desc type="value" text="取消按钮文案">取消按钮文案</desc><desc type="prop" text="cancelColor">cancelColor</desc><desc type="value" text="取消按钮文本色">取消按钮文本色</desc><mx-dialog-column visible="{{visibleCancel}}" title="标题" cancelText="放弃" cancelColor="#1677FF" options="{{options}}" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><view class="cons"><mx-btn width="240rpx" small bind:btn_tap="handleCancel">更改文案&文本色</mx-btn></view></wrap><wrap><title type="h2">是否显示返回按钮</title><desc type="prop" text="showBack">showBack</desc><mx-dialog-column visible="{{visibleBack}}" showBack="{{false}}" options="{{options}}" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><view class="cons"><mx-btn width="140rpx" small bind:btn_tap="handleBack">不显示</mx-btn></view></wrap><wrap><title type="h2">返回按钮自定义</title><desc type="prop" text="backIcon">backIcon</desc><desc type="prop" text="backIcon.iconName">backIcon.iconName</desc><desc type="prop" text="backIcon.iconColor">backIcon.iconColor</desc><desc type="prop" text="backIcon.iconUrl">backIcon.iconUrl</desc><desc type="prop" text="backIcon.iconSize">backIcon.iconSize</desc><desc type="value" text="默认48，不带单位">默认48，不带单位</desc><mx-dialog-column visible="{{visibleBackIcon}}" backIcon="{{backIcon}}" options="{{options}}" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleBack2">自定义图标</mx-btn><view class="space"></view><mx-btn width="160rpx" small bind:btn_tap="handleBack3">自定义图片</mx-btn></view></wrap><wrap><title type="h2">是否显示关闭按钮</title><desc type="prop" text="showClose">showClose</desc><mx-dialog-column visible="{{visibleClose}}" showClose="{{false}}" options="{{options}}" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><view class="cons"><mx-btn width="140rpx" small bind:btn_tap="handleClose">不显示</mx-btn></view></wrap><wrap><title type="h2">关闭按钮自定义</title><desc type="prop" text="closeIcon">closeIcon</desc><desc type="prop" text="closeIcon.iconName">closeIcon.iconName</desc><desc type="prop" text="closeIcon.iconColor">closeIcon.iconColor</desc><desc type="prop" text="closeIcon.iconUrl">closeIcon.iconUrl</desc><desc type="prop" text="closeIcon.iconSize">closeIcon.iconSize</desc><desc type="value" text="默认48，不带单位">默认48，不带单位</desc><mx-dialog-column visible="{{visibleCloseIcon}}" closeIcon="{{closeIcon}}" options="{{options}}" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleClose2">自定义图标</mx-btn><view class="space"></view><mx-btn width="160rpx" small bind:btn_tap="handleClose3">自定义图片</mx-btn></view></wrap><wrap><title type="h2">层级</title><desc type="prop" text="zIndex">zIndex</desc><mx-dialog-column visible="{{false}}" zIndex="1" options="{{options}}" /></wrap><wrap><title type="h2">点击蒙层是否可以关闭弹窗</title><desc type="prop" text="isCloseMask">isCloseMask</desc><mx-dialog-column visible="{{visibleMaskClose}}" isCloseMask="{{false}}" options="{{options}}" bind:dialog_column_back="handleBackFun" bind:dialog_column_close="handleCancelFun" /><view class="cons"><mx-btn width="200rpx" small bind:btn_tap="handleMaskClose">蒙层不可关闭</mx-btn></view></wrap><wrap><title type="h2">自定义左侧宽度</title><desc type="prop" text="leftWidth">leftWidth</desc><mx-dialog-column visible="{{visibleLeftWidth}}" leftWidth="320" height="80vh" options="{{options}}" /><view class="cons"><mx-btn width="230rpx" small bind:btn_tap="handleLeftWidth">自定义左侧宽度</mx-btn></view></wrap><wrap><title type="h2">自定义高度</title><desc type="prop" text="height">height</desc><desc type="value" text="默认75vh">默认75vh</desc><mx-dialog-column visible="{{false}}" height="80vh" options="{{options}}" /></wrap><wrap><title type="h2">事件</title><desc type="prop" text="bind:dialog_column_close">bind:dialog_column_close</desc><desc type="value" text="弹窗关闭，返回type，当前触发关闭的位置；当有选中子项时会返回value、current、item、subCurrent、subValue 和 subItem">弹窗关闭，返回type，当前触发关闭的位置；当有选中子项时会返回value、current、item、subCurrent、subValue 和 subItem</desc><desc type="prop" text="bind:dialog_column_back">bind:dialog_column_back</desc><desc type="value" text="弹窗返回，当有选中子项时会返回value、current、item、subCurrent、subValue 和 subItem">弹窗返回，当有选中子项时会返回value、current、item、subCurrent、subValue 和 subItem</desc><mx-dialog-column visible="{{visibleHandle}}" options="{{options}}" bind:dialog_column_close="handleCancelFun" bind:dialog_column_back="handleBackFun" /><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleHandle">事件</mx-btn></view></wrap><prop-table dataSource="{{propDocs}}" /></view>