<view class="pageDemo"><mx-nav title="徽标" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Badge">Badge</desc><desc>徽标，红点、数字或文字。用于告诉用户待处理的事物或更新数。</desc></view><wrap><title type="h2">基本用法</title><desc type="prop" text="type">type</desc><desc type="value" text="dot / text / number / bubble">dot / text / number / bubble</desc><view class="cons"><view class="badgeList"><mx-badge type="dot" position="top-right"><view class="box"></view></mx-badge><mx-badge type="text" text="新" position="top-right"><view class="box"></view></mx-badge><mx-badge type="number" text="{{2}}" position="top-right"><view class="box"></view></mx-badge><mx-badge type="number" text="{{100}}" position="top-right"><view class="box"></view></mx-badge><mx-badge type="bubble" text="new" position="top-right"><view class="box"></view></mx-badge></view></view></wrap><wrap><title type="h2">带边框</title><desc type="prop" text="stroke">stroke</desc><view class="cons"><view class="badgeList"><mx-badge type="dot" stroke position="top-right"><view class="box"></view></mx-badge><mx-badge type="text" text="新" stroke position="top-right"><view class="box"></view></mx-badge><mx-badge type="number" text="{{1}}" stroke position="top-right"><view class="box"></view></mx-badge><mx-badge type="number" text="{{100}}" stroke position="top-right"><view class="box"></view></mx-badge><mx-badge type="bubble" text="new" stroke position="top-right"><view class="box"></view></mx-badge></view></view></wrap><wrap><title type="h2">自定义背景和位置</title><desc type="prop" text="position / bgColor">position / bgColor</desc><view class="cons"><view class="badgeList"><mx-badge type="number" text="{{1}}" position="top-left"><view class="box"></view></mx-badge><mx-badge type="bubble" text="1" position="bottom-right"><view class="box"></view></mx-badge><mx-badge type="number" text="{{100}}" stroke bgColor="#1677FF"><view class="box"></view></mx-badge><mx-badge type="text" text="new" bgColor="#FF9F18" position="top-center"><view class="box"></view></mx-badge><mx-badge type="bubble" text="new" stroke bgColor="#34B368"><view class="box"></view></mx-badge></view></view></wrap><wrap><title type="h2">设置偏移</title><desc type="prop" text="offsetX / offsetY">offsetX / offsetY</desc><view class="cons"><view class="badgeList"><mx-badge type="text" text="1" offsetX="-20px" offsetY="0px"><view class="box"></view></mx-badge><mx-badge type="text" text="1" position="bottom-right" offsetX="-20px" offsetY="-14px"><view class="box"></view></mx-badge><mx-badge type="bubble" text="new" position="top-right" offsetX="2px" offsetY="-8px"><view class="box"></view></mx-badge></view></view></wrap><wrap><title type="h2">自定义内容</title><desc type="prop" text="slot=text">slot="text"</desc><view class="cons"><view class="badgeList"><mx-badge type="text" position="top-right"><mx-icon slot="text" name="remind" size="{{20}}" color="#FFFFFF" /><view class="avatar"><mx-icon name="my" size="{{40}}" color="#9AA0B1" /></view></mx-badge></view></view></wrap><wrap><title type="h2">深色背景描边</title><desc type="prop" text="stroke">stroke</desc><view class="cons"><view class="badgeList"><mx-badge type="dot" stroke><view class="box boxDark"></view></mx-badge><mx-badge type="number" text="{{8}}" stroke><view class="box boxDark"></view></mx-badge><mx-badge type="text" text="HOT" stroke><view class="box boxDark"></view></mx-badge></view></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 