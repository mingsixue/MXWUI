Change" bind:textarea_focus="textareaFocus" bind:textarea_blur="textareaBlur" bind:textarea_line_change="textareaLineChange" bind:textarea_confirm="textareaConfirm" bind:textarea_keyboard_height_change="textareaKeyboardHeightChange" desc="这是描述下文本哦" descColor="#CA0E2D" /><line /><mx-textarea styleType="web" bind:textarea_change="textareaChange" bind:textarea_focus="textareaFocus" bind:textarea_blur="textareaBlur" bind:textarea_line_change="textareaLineChange" bind:textarea_confirm="textareaConfirm" bind:textarea_keyboard_height_change="textareaKeyboardHeightChange" desc="这是描述下文本哦" descColor="#CA0E2D" /></wrap><wrap><title type="h2">左侧自定义宽度</title><desc type="prop" text="leftWidth">leftWidth</desc></wrap><wrap><title type="h2">标签文案</title><desc type="prop" text="label">label</desc><desc type="prop" text="labelColor">labelColor</desc><desc type="prop" text="labelAlign">labelAlign</desc><desc type="value" text="对齐方式，left / center / right">对齐方式，left / center / right</desc><mx-textarea styleType="horizontal" label="标签文案" /><mx-textarea styleType="horizontal" label="标签文案" labelColor="#1677FF" /><mx-textarea styleType="web" label="标签文案" /></wrap><wrap><title type="h2">是否显示必填星号</title><desc type="prop" text="required">required</desc><desc type="prop" text="requiredPosition">requiredPosition</desc><desc type="value" text="left、right">left、right</desc><mx-textarea styleType="horizontal" label="标签文案" required /><mx-textarea styleType="horizontal" label="标签文案" required requiredPosition="left" /></wrap><wrap><title type="h2">标签前图标</title><desc type="prop" text="firstIcon">firstIcon</desc><mx-textarea styleType="horizontal" label="标签文本" firstIcon="{{firstIcon}}" bind:textarea_change="textareaChange" bind:textarea_firstIcon="handleFirstIcon" /><mx-textarea styleType="horizontal" label="标签文本" firstIcon="{{firstIcon2}}" bind:textarea_change="textareaChange" bind:textarea_firstIcon="handleFirstIcon" /></wrap><wrap><title type="h2">标签后图标</title><desc type="prop" text="lastIcon">lastIcon</desc><mx-textarea styleType="horizontal" label="标签文本" lastIcon="{{lastIcon}}" bind:textarea_change="textareaChange" bind:textarea_lastIcon="handleLastIcon" /><mx-textarea styleType="horizontal" label="标签文本" lastIcon="{{lastIcon2}}" bind:textarea_change="textareaChange" bind:textarea_lastIcon="handleLastIcon" /></wrap><wrap><title type="h2">是否横向布局</title><desc type="prop" text="horizontal">horizontal</desc><mx-textarea styleType="web" label="标签文本" horizontal="{{true}}" bind:textarea_change="textareaChange" bind:textarea_lastIcon="handleLastIcon" /></wrap><prop-table dataSource="{{propDocs}}" /></view>