<view class="pageDemo"><mx-nav title="空数据" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Empty">Empty</desc><desc>用于展示空数据时的情况，支持自定义图标，支持引导按钮，单按钮、双按钮</desc></view><wrap><title type="h2">基础用法</title><mx-empty /><line /></wrap><wrap><title type="h2">缺省文案</title><desc type="prop" text="text">text</desc><mx-empty text="暂无内容" /><desc type="prop" text="textColor">textColor</desc><mx-empty text="暂无内容" textColor="#f00" /></wrap><wrap><title type="h2">描述文案</title><desc type="prop" text="desc">desc</desc><mx-empty desc="这是描述文案" /><desc type="prop" text="descColor">descColor</desc><mx-empty desc="这是描述文案" descColor="#00f" /></wrap><wrap><title type="h2">单按钮</title><desc type="prop" text="mainBtnText">mainBtnText</desc><desc type="value" text="主按钮文案">主按钮文案</desc><desc type="prop" text="bind:empty_main_tap">bind:empty_main_tap</desc><desc type="value" text="主按钮点击事件">主按钮点击事件</desc><mx-empty mainBtnText="主按钮" bind:empty_main_tap="handleMainBtn" /></wrap><wrap><title type="h2">双按钮</title><desc type="prop" text="mainBtnText">mainBtnText</desc><desc type="value" text="主按钮文案">主按钮文案</desc><desc type="prop" text="bind:empty_main_tap">bind:empty_main_tap</desc><desc type="value" text="主按钮点击事件">主按钮点击事件</desc><desc type="prop" text="minorBtnText">minorBtnText</desc><desc type="value" text="次按钮文案">次按钮文案</desc><desc type="prop" text="bind:empty_minor_tap">bind:empty_minor_tap</desc><desc type="value" text="次按钮点击事件">次按钮点击事件</desc><mx-empty mainBtnText="主按钮" bind:empty_main_tap="handleMainBtn" minorBtnText="次按钮" bind:empty_minor_tap="handleMinorBtn" /></wrap><wrap><title type="h2">按钮自定义颜色</title><desc type="prop" text="mainBtnThemeColor">mainBtnThemeColor</desc><desc type="value" text="主按钮颜色">主按钮颜色</desc><desc type="prop" text="minorBtnThemeColor">minorBtnThemeColor</desc><desc type="value" text="次按钮颜色">次按钮颜色</desc><mx-empty mainBtnText="主按钮" mainBtnThemeColor="#1677FF" bind:empty_main_tap="handleMainBtn"  minorBtnText="次按钮"  minorBtnThemeColor="#