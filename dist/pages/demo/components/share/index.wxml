<view class="pageDemo"><mx-nav title="分享弹窗" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Share">Share</desc><desc>分享弹窗组件，只提供基础的样式，具体逻辑需要自行实现。</desc></view><wrap><title type="h2">是否显示弹窗</title><desc type="prop" text="visible">visible</desc><mx-share visible="{{visible}}" bind:share_close="handleClose" /><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleVisible">查看</mx-btn></view></wrap><wrap><title type="h2">标题</title><desc type="prop" text="title">title</desc><mx-share visible="{{visibleTitle}}" title="主标题（支持自定义颜色）" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleTitle">设置标题</mx-btn></view></wrap><wrap><title type="h2">标题颜色</title><desc type="prop" text="titleColor">titleColor</desc><mx-share visible="{{visibleTitle2}}" title="主标题（支持自定义颜色）" titleColor="#CA0E2D" /><view class="cons"><mx-btn width="200rpx" small bind:btn_tap="handleTitle2">设置标题颜色</mx-btn></view></wrap><wrap><title type="h2">描述</title><desc type="prop" text="desc">desc</desc><mx-share visible="{{visibleDesc}}" desc="副标题副标题副标题副（支持自定义颜色）" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleDesc">设置描述</mx-btn></view></wrap><wrap><title type="h2">描述颜色</title><desc type="prop" text="descColor">descColor</desc><mx-share visible="{{visibleDesc2}}" desc="副标题副标题副标题副（支持自定义颜色）" descColor="#1677FF" /><view class="cons"><mx-btn width="200rpx" small bind:btn_tap="handleDesc2">设置描述颜色</mx-btn></view></wrap><wrap><title type="h2">自定义头部图片</title><desc type="prop" text="imgUrl">imgUrl</desc><mx-share visible="{{false}}" imgUrl="" /></wrap><wrap><title type="h2">是否显示某一项</title><desc type="prop" text="showWechat">showWechat</desc><desc type="value" text="是否显示微信好友">是否显示微信好友</desc><desc type="prop" text="showFriends">showFriends</desc><desc type="value" text="是否显示朋友圈">是否显示朋友圈</desc><desc type="prop" text="showQrcode">showQrcode</desc><desc type="value" text="是否显示二维码">是否显示二维码</desc><desc type="prop" text="showCopyLink">showCopyLink</desc><desc type="value" text="是否显示复制链接">是否显示复制链接</desc><mx-share visible="{{visibleItem}}" title="自定义内容项" showFriends="{{false}}" /><view class="cons"><mx-btn width="200rpx" small bind:btn_tap="handleItem">不显示朋友圈</mx-btn></view></wrap><wrap><title type="h2">层级</title><desc type="prop" text="zIndex">zIndex</desc><mx-share visible="{{false}}" zIndex="1" /></wrap><wrap><title type="h2">蒙层是否可以关闭弹窗</title><desc type="prop" text="isCloseMask">isCloseMask</desc><mx-share visible="{{visibleMaskClose}}" isCloseMask="{{false}}" /><view class="cons"><mx-btn width="200rpx" small bind:btn_tap="handleMaskClose">蒙层不可关闭</mx-btn></view></wrap><wrap><title type="h2">事件</title><desc type="prop" text="bind:share_close">bind:share_close</desc><desc type="value" text="弹窗关闭">弹窗关闭</desc><desc type="prop" text="bind:share_wechat">bind:share_wechat</desc><desc type="value" text="点击微信好友">点击微信好友</desc><desc type="prop" text="bind:share_friends">bind:share_friends</desc><desc type="value" text="点击朋友圈">点击朋友圈</desc><desc type="prop" text="bind:share_qrcode">bind:share_qrcode</desc><desc type="value" text="点击二维码">点击二维码</desc><desc type="prop" text="bind:share_copylink">bind:share_copylink</desc><desc type="value" text="点击复制链接">点击复制链接</desc><mx-share visible="{{visibleHandle}}" showFriends="{{true}}" showQrcode="{{true}}" bind:share_close="handleClose" bind:share_wechat="handleWechat" bind:share_friends="handleFriends" bind:share_qrcode="handleQrcode" bind:share_copylink="handleCopylink" /><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleHandle">事件</mx-btn></view></wrap><prop-table dataSource="{{propDocs}}" /></view>