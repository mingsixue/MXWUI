<view class="pageDemo"><mx-nav title="优惠券" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Coupon">Coupon</desc><desc>通用优惠券展示组件，支持尺寸、排列方式、禁用态与行动按钮</desc></view><wrap><title type="h2">基本使用</title><desc type="prop" text="dataSource">dataSource</desc><view class="cons"><mx-coupon dataSource="{{basicList}}" bind:coupon_tap="handleCouponTap" bind:coupon_btn_tap="handleBtnTap" /></view></wrap><wrap><title type="h2">小号券样式</title><desc type="prop" text="size">size</desc><desc type="value" text="small">small</desc><view class="cons"><mx-coupon size="small" dataSource="{{smallList}}" bind:coupon_tap="handleCouponTap" bind:coupon_btn_tap="handleBtnTap" /></view></wrap><wrap><title type="h2">水平排列</title><desc type="prop" text="direction">direction</desc><desc type="value" text="horizontal">horizontal（默认）</desc><view class="cons cons--flush"><mx-coupon direction="horizontal" dataSource="{{horizontalList}}" bind:coupon_tap="handleCouponTap" bind:coupon_btn_tap="handleBtnTap" /></view></wrap><wrap><title type="h2">竖直排列</title><desc type="prop" text="direction">direction</desc><desc type="value" text="vertical">vertical</desc><view class="cons"><mx-coupon direction="vertical" dataSource="{{verticalList}}" bind:coupon_tap="handleCouponTap" bind:coupon_btn_tap="handleBtnTap" /></view></wrap><wrap><title type="h2">有效期（精确到时分秒）</title><desc type="prop" text="validTime">validTime</desc><desc type="prop" text="validTimeText">validTimeText</desc><desc type="prop" text="validTimePrefix">validTimePrefix</desc><view class="cons"><mx-coupon direction="vertical" dataSource="{{validTimeList}}" bind:coupon_tap="handleCouponTap" bind:coupon_btn_tap="handleBtnTap" /></view></wrap><wrap><title type="h2">多列排列</title><desc type="prop" text="direction">direction</desc><desc type="value" text="multipleColumn">multipleColumn</desc><view class="cons"><mx-coupon direction="multipleColumn" dataSource="{{multiColumnList}}" bind:coupon_tap="handleCouponTap" bind:coupon_btn_tap="handleBtnTap" /></view></wrap><wrap><title type="h2">禁用态</title><desc type="prop" text="disabled">item.disabled</desc><view class="cons"><mx-coupon direction="vertical" dataSource="{{disabledList}}" /></view></wrap><wrap><title type="h2">自定义主题色</title><desc type="prop" text="themeColor">themeColor</desc><view class="cons"><mx-coupon themeColor="#1677FF" dataSource="{{themeList}}" bind:coupon_tap="handleCouponTap" bind:coupon_btn_tap="handleBtnTap" /></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 