<view class="pageDemo"><mx-nav title="骨架屏" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Skeleton">Skeleton</desc><desc>在需要等待加载内容的位置提供占位图形组合</desc></view><wrap><title type="h2">基础用法</title><desc type="prop" text="animate">animate</desc><view class="cons"><mx-skeleton animate="{{true}}" /></view></wrap><wrap><title type="h2">带头像</title><desc type="prop" text="avatar">avatar</desc><desc type="prop" text="avatarShape">avatarShape</desc><view class="cons"><mx-skeleton animate="{{true}}" avatar="{{true}}" avatarShape="circle" /></view></wrap><wrap><title type="h2">无标题 / 自定义行数</title><desc type="prop" text="title">title</desc><desc type="prop" text="rows">rows</desc><view class="cons"><mx-skeleton animate="{{true}}" title="{{false}}" rows="{{5}}" /></view></wrap><wrap><title type="h2">加载切换</title><desc type="prop" text="loading">loading</desc><view class="cons"><view class="toolbar"><mx-btn width="200rpx" small bind:btn_tap="handleToggleLoading" >{{showLoading ? '显示内容' : '显示骨架'}}</mx-btn></view><mx-skeleton loading="{{showLoading}}" animate="{{true}}" avatar="{{true}}" avatarShape="circle" title="{{false}}" rows="{{3}}" ><view class="contentCard"><view class="contentAvatar"></view><view class="contentBody"><view class="contentTitle">MXWUI</view><view class="contentDesc"> 在需要等待加载内容的位置提供一个占位图形组合，适用于图文信息较多的首页、列表与卡片。 </view></view></view></mx-skeleton></view></wrap><wrap><title type="h2">自定义组合</title><desc>子组件 Avatar / Title / Paragraph / Input / Button</desc><view class="cons"><view class="combo"><mx-skeleton-avatar animate="{{true}}" shape="circle" size="large" /><view class="comboMain"><mx-skeleton-title animate="{{true}}" /><mx-skeleton-paragraph animate="{{true}}" rows="{{2}}" /></view></view><view class="comboGap"><mx-skeleton-input animate="{{true}}" customStyle="max-width:100%;margin-bottom:16rpx;" /><mx-skeleton-input animate="{{true}}" customStyle="max-width:100%;margin-bottom:16rpx;" /><mx-skeleton-button animate="{{true}}" size="medium" /></view></view></wrap><wrap><title type="h2">头像形状与尺寸</title><desc type="prop" text="shape">shape</desc><desc type="prop" text="size">size</desc><view class="cons"><view class="row"><view class="item"><mx-skeleton-avatar animate="{{true}}" shape="circle" size="x-small" /><text class="label">x-small</text></view><view class="item"><mx-skeleton-avatar animate="{{true}}" shape="circle" size="small" /><text class="label">small</text></view><view class="item"><mx-skeleton-avatar animate="{{true}}" shape="circle" size="medium" /><text class="label">medium</text></view><view class="item"><mx-skeleton-avatar animate="{{true}}" shape="circle" size="large" /><text class="label">large</text></view></view><view class="row rowGap"><view class="item"><mx-skeleton-avatar animate="{{true}}" shape="square" size="medium" /><text class="label">square</text></view><view class="item"><mx-skeleton-avatar animate="{{true}}" shape="circle" size="88rpx" /><text class="label">88rpx</text></view></view></view></wrap><wrap><title type="h2">按钮尺寸</title><desc type="prop" text="size">size</desc><view class="cons"><view class="row"><view class="item"><mx-skeleton-button animate="{{true}}" size="small" /><text class="label">small</text></view><view class="item"><mx-skeleton-button animate="{{true}}" size="medium" /><text class="label">medium</text></view><view class="item"><mx-skeleton-button animate="{{true}}" size="large" /><text class="label">large</text></view></view></view></wrap><wrap><title type="h2">自定义占位</title><desc type="prop" text="customStyle">customStyle</desc><view class="cons"><view class="customRow"><mx-skeleton-custom animate="{{true}}" customStyle="width:200rpx;height:200rpx;border-radius:16rpx;" /><mx-skeleton-custom animate="{{true}}" customStyle="width:120rpx;height:120rpx;border-radius:50%;" /><mx-skeleton-custom animate="{{true}}" customStyle="flex:1;height:80rpx;border-radius:12rpx;" /></view></view></wrap><wrap><title type="h2">无动画</title><desc type="prop" text="animate">animate="{{false}}"</desc><view class="cons"><mx-skeleton avatar="{{true}}" avatarShape="circle" /></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 