.pageDemo{min-height:100vh;padding-bottom:48rpx;padding-bottom:calc(constant(safe-area-inset-bottom) + 48rpx);padding-bottom:calc(env(safe-area-inset-bottom) + 48rpx);background:#f8f9fa;box-sizing:border-box}.demoIntro{position:relative;padding:32rpx 0 20rpx;margin-bottom:8rpx}.demoIntro::before{content:'';position:absolute;left:0;right:0;top:0;bottom:0;z-index:0;background:radial-gradient(ellipse 80% 90% at 0 0,rgba(202,14,45,.1) 0,transparent 55%),linear-gradient(180deg,#fff 0,#f8f9fa 100%);pointer-events:none}.demoIntro>desc,.demoIntro>title,.demoIntro>view{position:relative;z-index:1}.cons{display:flex;flex-wrap:wrap;align-items:center;margin:8rpx 48rpx 16rpx}.cons .space{display:inline-block;width:24rpx}.pageDemo .cons{display:block;margin:8rpx 48rpx 16rpx;padding:24rpx 16rpx}.pageDemo .toolbar{margin-bottom:24rpx}.pageDemo .contentCard{display:flex;flex-direction:row;align-items:flex-start}.pageDemo .contentAvatar{flex-shrink:0;width:92rpx;height:92rpx;margin-right:24rpx;border-radius:50%;background:linear-gradient(135deg,#ca0e2d 0,#e85a6f 100%)}.pageDemo .contentBody{flex:1;min-width:0}.pageDemo .contentTitle{margin-bottom:12rpx;font-size:30rpx;font-weight:600;color:#040a23;line-height:1.4}.pageDemo .contentDesc{font-size:26rpx;color:#656979;line-height:1.6}.pageDemo .combo{display:flex;flex-direction:row;align-items:flex-start;margin-bottom:24rpx}.pageDemo .comboMain{flex:1;min-width:0;margin-left:24rpx;padding-top:8rpx}.pageDemo .comboGap{margin-top:8rpx}.pageDemo .row{display:flex;flex-direction:row;flex-wrap:wrap;align-items:flex-end;gap:32rpx}.pageDemo .rowGap{margin-top:32rpx}.pageDemo .item{display:flex;flex-direction:column;align-items:center;gap:12rpx}.pageDemo .label{font-size:22rpx;color:#9aa0b1;line-height:1}.pageDemo .customRow{display:flex;flex-direction:row;align-items:center;gap:24rpx}