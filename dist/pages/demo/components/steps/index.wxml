<view class="pageDemo"><mx-nav title="步骤条" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Steps">Steps</desc><desc>引导用户按照流程完成任务的导航条。</desc><desc>当任务复杂或存在先后关系时，将其分解成一系列步骤。</desc></view><wrap><title type="h2">基本用法</title><desc type="prop" text="items">items</desc><desc type="value" text="步骤数据数组">步骤数据数组</desc><desc type="prop" text="items[x].title">items[x].title</desc><desc type="value" text="标题">标题</desc><desc type="prop" text="items[x].desc">items[x].desc</desc><desc type="value" text="描述，也支持 description">描述，也支持 description</desc><desc type="prop" text="current">current</desc><desc type="value" text="当前步骤，从 0 开始">当前步骤，从 0 开始</desc><view class="stepsDemo"><mx-steps items="{{items}}" current="{{1}}" /></view></wrap><wrap><title type="h2">纵向步骤条</title><desc type="prop" text="direction">direction</desc><desc type="value" text="horizontal / vertical">horizontal / vertical</desc><view class="stepsDemoVertical"><mx-steps items="{{items}}" current="{{1}}" direction="vertical" /></view></wrap><wrap><title type="h2">小圆点</title><desc type="prop" text="type">type</desc><desc type="value" text="default / dot">default / dot</desc><view class="stepsDemo"><mx-steps items="{{itemsDot}}" current="{{0}}" type="dot" /></view><line /><view class="stepsDemoVertical"><mx-steps items="{{items}}" current="{{1}}" type="dot" direction="vertical" /></view></wrap><wrap><title type="h2">当前步骤状态</title><desc type="prop" text="status">status</desc><desc type="value" text="process / finish / error / wait">process / finish / error / wait</desc><desc>进行中 process</desc><view class="stepsDemo"><mx-steps items="{{items}}" current="{{1}}" status="process" /></view><line /><desc>已完成 finish</desc><view class="stepsDemo"><mx-steps items="{{items}}" current="{{1}}" status="finish" /></view><line /><desc>失败 error</desc><view class="stepsDemo"><mx-steps items="{{items}}" current="{{1}}" status="error" /></view></wrap><wrap><title type="h2">单项失败</title><desc type="prop" text="items[x].fail">items[x].fail</desc><desc type="value" text="true / false">true / false</desc><desc type="prop" text="items[x].status">items[x].status</desc><desc type="value" text="可覆盖单项状态">可覆盖单项状态</desc><view class="stepsDemo"><mx-steps items="{{itemsFail}}" current="{{1}}" /></view></wrap><wrap><title type="h2">受控切换</title><desc type="prop" text="current">current</desc><desc type="value" text="当前：{{current}}">当前：{{current}}</desc><view class="stepsDemo"><mx-steps items="{{items}}" current="{{current}}" /></view><view class="stepsAction"><view class="stepsActionBtn"><mx-btn width="200rpx" small bind:btn_tap="handlePrev">上一步</mx-btn></view><view class="stepsActionBtn"><mx-btn width="200rpx" small bind:btn_tap="handleNext">下一步</mx-btn></view></view></wrap><wrap><title type="h2">可点击切换</title><desc type="prop" text="clickable">clickable</desc><desc type="value" text="true / false">true / false</desc><desc type="prop" text="bind:steps_change">bind:steps_change</desc><view class="stepsDemo"><mx-steps items="{{itemsLong}}" current="{{current}}" clickable bind:steps_change="handleChange" /></view></wrap><wrap><title type="h2">自定义图标</title><desc type="prop" text="items[x].iconName">items[x].iconName</desc><desc type="value" text="图标库名称">图标库名称</desc><desc type="prop" text="items[x].iconUrl">items[x].iconUrl</desc><desc type="value" text="自定义图片">自定义图片</desc><view class="stepsDemo"><mx-steps items="{{itemsIcon}}" current="{{1}}" /></view></wrap><wrap><title type="h2">自定义颜色</title><desc type="prop" text="activeColor">activeColor</desc><desc type="prop" text="inactiveColor">inactiveColor</desc><desc type="prop" text="errorColor">errorColor</desc><desc type="prop" text="titleColor">titleColor</desc><desc type="prop" text="descColor">descColor</desc><view class="stepsDemo"><mx-steps items="{{items}}" current="{{1}}" activeColor="#1677FF" inactiveColor="#C0C4CC" titleColor="#1677FF" descColor="#909399" /></view><line /><view class="stepsDemoVertical"><mx-steps items="{{items}}" current="{{1}}" status="error" direction="vertical" activeColor="#098562" errorColor="#CA0E2D" /></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 