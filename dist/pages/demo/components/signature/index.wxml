<view class="pageDemo"><mx-nav title="签名" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="Signature">Signature</desc><desc>手写签名画板，支持清除、导出图片与禁用只读</desc></view><wrap><title type="h2">基本用法</title><view class="cons"><mx-signature id="signatureBasic" bind:signature_change="onSignatureChange" bind:signature_clear="onSignatureClear" /><view class="tip">状态：{{emptyTip}}</view></view><view class="btnRow"><view class="btnItem"><mx-btn width="160rpx" small type="default" bind:btn_tap="handleClear">清空</mx-btn></view></view></wrap><wrap><title type="h2">自定义笔迹</title><desc type="prop" text="penColor / penWidth">penColor / penWidth</desc><view class="cons"><mx-signature penColor="#CA0E2D" penWidth="{{5}}" placeholder="请用红色笔签名" /></view></wrap><wrap><title type="h2">自定义背景与高度</title><desc type="prop" text="bgColor">bgColor</desc><desc type="prop" text="height">height</desc><view class="cons"><mx-signature height="{{280}}" bgColor="#F8F9FA" placeholder="浅色背景签名区" /></view></wrap><wrap><title type="h2">隐藏内置清除</title><desc type="prop" text="showClear">showClear</desc><view class="cons"><mx-signature showClear="{{false}}" /></view></wrap><wrap><title type="h2">确认导出</title><desc type="prop" text="showConfirm">showConfirm</desc><desc type="prop" text="bind:signature_confirm">bind:signature_confirm</desc><view class="cons"><mx-signature showConfirm bind:signature_confirm="onSignatureConfirm" bind:signature_clear="onSignatureClear" /><view class="preview" wx:if="{{previewPath}}"><image class="previewImg" src="{{previewPath}}" mode="aspectFit" /></view></view></wrap><wrap><title type="h2">方法导出</title><desc type="prop" text="toTempFilePath / clear">toTempFilePath / clear</desc><view class="cons"><mx-signature id="signatureExport" showClear="{{false}}" /><view class="preview" wx:if="{{exportPath}}"><image class="previewImg" src="{{exportPath}}" mode="aspectFit" /></view></view><view class="btnRow"><view class="btnItem"><mx-btn width="160rpx" small type="default" bind:btn_tap="handleClearExport">清空</mx-btn></view><view class="btnItem"><mx-btn width="160rpx" small bind:btn_tap="handleExport">导出</mx-btn></view></view></wrap><wrap><title type="h2">禁用</title><desc type="prop" text="disabled">disabled</desc><view class="cons"><mx-signature disabled placeholder="已禁用，无法签名" /></view></wrap><wrap><title type="h2">只读</title><desc type="prop" text="readonly">readonly</desc><view class="cons"><mx-signature readonly placeholder="只读模式" /></view></wrap><line /><prop-table dataSource="{{propDocs}}" /></view> 