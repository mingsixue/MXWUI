<view class="pageDemo"><mx-nav title="按钮操作栏" /><view style="height:{{navHeight}}px;"></view><view class="demoIntro"><desc type="name" text="ActionSheet">ActionSheet</desc><desc>由底部出现的列表形式的操作按钮栏弹窗。</desc></view><wrap><title type="h2">是否显示弹窗</title><desc type="prop" text="visible">visible</desc><mx-action-sheet visible="{{visible}}" options="{{options}}" /><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleVisible">查看</mx-btn></view></wrap><wrap><title type="h2">标题</title><desc type="prop" text="title">title</desc><mx-action-sheet visible="{{visibleTitle}}" title="自定义标题" options="{{options}}" /><view class="cons"><mx-btn width="140rpx" small bind:btn_tap="handleTitle">设置标题</mx-btn></view></wrap><wrap><title type="h2">标题文本色</title><desc type="prop" text="titleColor">titleColor</desc><mx-action-sheet visible="{{visibleTitleColor}}" title="自定义标题文本色" titleColor="#1677FF" options="{{options}}" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleTitleColor">标题文本色</mx-btn></view></wrap><wrap><title type="h2">是否显示取消按钮</title><desc type="prop" text="showCancel">showCancel</desc><mx-action-sheet visible="{{visibleClose}}" options="{{options}}" showCancel="{{false}}" /><view class="cons"><mx-btn width="140rpx" small bind:btn_tap="handleClose">不显示</mx-btn></view></wrap><wrap><title type="h2">自定义图标&自定义图片</title><desc type="prop" text="options[x].iconName">options[x].iconName</desc><desc type="prop" text="options[x].iconColor">options[x].iconColor</desc><desc type="prop" text="options[x].iconUrl">options[x].iconUrl</desc><desc type="prop" text="options[x].iconSize">options[x].iconSize</desc><mx-action-sheet visible="{{visibleOptions}}" options="{{options2}}" /><view class="cons"><mx-btn width="160rpx" small bind:btn_tap="handleOptions">自定义图标</mx-btn></view></wrap><wrap><title type="h2">自定义文本色</title><desc type="prop" text="options[x].color">options[x].color</desc><mx-action-sheet visible="{{visibleOptions2}}" options="{{options3}}" /><view class="cons"><mx-btn width="190rpx" small bind:btn_tap="handleOptions2">自定义文本色</mx-btn></view></wrap><wrap><title type="h2">层级</title><desc type="prop" text="zIndex">zIndex</desc><mx-action-sheet visible="{{false}}" options="{{options}}" zIndex="1" /></wrap><wrap><title type="h2">蒙层是否可以关闭弹窗</title><desc type="prop" text="isCloseMask">isCloseMask</desc><mx-action-sheet visible="{{visibleMaskClose}}" options="{{options}}" isCloseMask="{{false}}" /><view class="cons"><mx-btn width="200rpx" small bind:btn_tap="handleMaskClose">蒙层不可关闭</mx-btn></view></wrap><wrap><title type="h2">事件</title><desc type="prop" text="bind:action_sheet_tap">bind:action_sheet_tap</desc><desc type="value" text="item点击回调事件">item点击回调事件</desc><desc type="prop" text="bind:action_sheet_close">bind:action_sheet_close</desc><desc type="value" text="取消按钮或弹窗关闭回调事件">取消按钮或弹窗关闭回调事件</desc><mx-action-sheet visible="{{visibleHandle}}" options="{{options}}" bind:action_sheet_tap="handleItemFun" bind:action_sheet_close="handleCancelFun" /><view class="cons"><mx-btn width="120rpx" small bind:btn_tap="handleHandle">事件</mx-btn></view></wrap><prop-table dataSource="{{propDocs}}" /></view>