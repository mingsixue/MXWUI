<view class="pageIndex"><mx-nav title="MXWUI" bind:iconTap="iconTap" /><view style="height:{{navHeight}}px;"></view><view class="hero"><view class="heroBg"></view><view class="heroInner"><image class="logo" mode="widthFix" src="https://cdn.mingsixue.com/xcx/MXWUI/mxwui.png" binderror="handleLogoError" /><view class="tagline">微信小程序原生 UI 组件库</view><view class="sub">覆盖按钮、表单、列表、弹窗等日常开发场景，按需引入，主题可配。</view></view></view><view class="section"><view class="sectionHead"><view class="sectionTitle">开始探索</view><view class="sectionDesc">从组件、示例或设计规范快速进入</view></view><view class="entries"><view class="entry" wx:for="{{entries}}" wx:key="url" bind:tap="handleGo" data-url="{{item.url}}" ><view class="entryIcon" style="background: {{item.bg}};"><mx-icon name="{{item.icon}}" size="44" color="{{item.color}}" /></view><view class="entryBody"><view class="entryName">{{item.name}}</view><view class="entryDesc">{{item.desc}}</view></view><mx-icon name="arrows_right" size="28" color="#9AA0B1" /></view></view></view><view class="section"><view class="sectionHead"><view class="sectionTitle">为何选择</view><view class="sectionDesc">面向业务落地的组件能力</view></view><view class="features"><view class="feature" wx:for="{{features}}" wx:key="title"><view class="featureBody"><view class="featureTitle">{{item.title}}</view><view class="featureDesc">{{item.desc}}</view></view></view></view></view><view class="section sectionLast"><view class="github" bind:tap="handleCopyUrl"><view class="githubLeft"><view class="githubIcon"><mx-icon name="github" size="48" color="#040A23" /></view><view class="githubInfo"><view class="githubTitle">开源仓库</view><view class="githubLink">github.com/mingsixue/mxwui</view></view></view><view class="githubCopy"><mx-icon name="copy" size="32" color="#656979" /><text>复制</text></view></view></view><menus current="0" /></view> 