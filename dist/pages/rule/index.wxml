<view class="pageRule"><mx-nav title="规范" /><view style="height:{{navHeight}}px;"></view><view class="intro"><view class="introBg"></view><view class="introInner"><view class="introTitle">设计规范</view><view class="introDesc">颜色、字号、边距、图标与层级的统一标准</view></view></view><view class="section"><view class="sectionHead"><view class="sectionTitle">基础约定</view><view class="sectionDesc">组件设计所遵循的通用前提</view></view><view class="principles"><view class="principle" wx:for="{{principles}}" wx:key="title"><view class="principleLabel">{{item.title}}</view><view class="principleDesc">{{item.desc}}</view></view></view></view><view class="section sectionLast"><view class="sectionHead"><view class="sectionTitle">具体规范</view><view class="sectionDesc">共 {{rules.length}} 项，点击查看详情</view></view><view class="list"><view class="item" wx:for="{{rules}}" wx:key="path" bind:tap="handleGo" data-url="{{item.path}}" ><view class="itemIcon" style="background: {{item.bg}};"><mx-icon name="{{item.icon}}" size="36" color="{{item.color}}" /></view><view class="itemBody"><view class="itemName">{{item.name}}</view><view class="itemDesc">{{item.desc}}</view></view><mx-icon name="arrows_right" size="28" color="#9AA0B1" /></view></view></view><view class="safeBottom"></view><menus current="3" /></view> 