<view class="pageColor"><mx-nav title="颜色规范" /><view style="height:{{navHeight}}px;"></view><view class="intro"><view class="introBg"></view><view class="introInner"><view class="introTitle">颜色规范</view><view class="introDesc">点击色块可复制色值，主题色与辅助色构成品牌识别</view></view></view><view class="section" wx:for="{{palettes}}" wx:key="title" wx:for-item="group"><view class="sectionHead"><view class="sectionTitle">{{group.title}}</view><view class="sectionDesc">{{group.desc}}</view></view><view class="swatchGrid"><view class="swatch" wx:for="{{group.list}}" wx:key="name" bind:tap="handleCopy" data-color="{{item.value}}" ><view class="swatchArea" style="background: {{item.value}};"></view><view class="swatchInfo"><view class="swatchName">{{item.name}}</view><view class="swatchValue">{{item.value}}</view></view></view></view></view><view class="section"><view class="sectionHead"><view class="sectionTitle">色阶</view><view class="sectionDesc">由浅到深，点击可复制</view></view><view class="levelCard"><view class="levelCol" wx:for="{{colorLevel}}" wx:key="*this"><view class="levelCell {{it.text ? 'levelCellLabel' : ''}}" wx:for="{{item}}" wx:for-item="it" wx:key="value" style="background: {{it.value}};" bind:tap="handleCopy" data-color="{{it.value}}" ><text wx:if="{{it.text}}" class="levelText">{{it.text}}</text></view></view></view></view><view class="section sectionLast"><view class="sectionHead"><view class="sectionTitle">渐变色</view><view class="sectionDesc">点击可复制完整渐变 CSS</view></view><view class="gradientList"><view class="gradientItem" wx:for="{{gradient}}" wx:key="name" bind:tap="handleCopy" data-color="background: linear-gradient(270deg, {{item.start}} 0%, {{item.end}} 100%);" ><view class="gradientBar" style="background: linear-gradient(270deg, {{item.start}} 0%, {{item.end}} 100%);" ></view><view class="gradientMeta"><view class="gradientName">{{item.name}}</view><view class="gradientRange">{{item.start}} → {{item.end}}</view></view></view></view></view><view class="safeBottom"></view></view> 