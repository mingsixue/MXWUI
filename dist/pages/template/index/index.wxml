<view class="pageTemplate"><mx-nav title="示例" /><view style="height:{{navHeight}}px;"></view><view class="intro"><view class="introBg"></view><view class="introInner"><view class="introTitle">使用示例</view><view class="introDesc">共 {{total}} 个页面模板，看组件如何组合落地</view></view></view><view class="tabsSticky" style="top: {{navHeight}}px;"><scroll-view class="tabs" scroll-x show-scrollbar="{{false}}"><view class="tabsInner"><view class="tab {{activeKey === item.key ? 'tabActive' : ''}}" wx:for="{{tabs}}" wx:key="key" bind:tap="handleTab" data-key="{{item.key}}" ><text>{{item.name}}</text><text class="tabCount" wx:if="{{item.count}}">{{item.count}}</text></view></view></scroll-view></view><view class="section" id="section-{{cat.key}}" wx:for="{{categories}}" wx:key="key" wx:for-item="cat" ><view class="sectionHead"><view class="sectionTitleWrap"><view class="sectionIcon" style="background: {{cat.bg}};"><mx-icon name="{{cat.icon}}" size="36" color="{{cat.color}}" /></view><view class="sectionMeta"><view class="sectionTitle">{{cat.name}}</view><view class="sectionDesc">{{cat.desc}}</view></view></view><view class="sectionCount">{{cat.list.length}}</view></view><view class="list"><view class="item" wx:for="{{cat.list}}" wx:key="url" wx:for-item="tpl" bind:tap="handleGo" data-url="{{tpl.url}}" ><view class="itemIcon" style="background: {{cat.bg}};"><mx-icon name="{{tpl.icon}}" size="36" color="{{cat.color}}" /></view><view class="itemBody"><view class="itemTop"><view class="itemLabel">{{tpl.label}}</view><view class="itemTag" wx:if="{{tpl.tag}}">{{tpl.tag}}</view></view><view class="itemDesc">{{tpl.desc}}</view></view><mx-icon name="arrows_right" size="28" color="#9AA0B1" /></view></view></view><view class="safeBottom"></view><menus current="2" /></view> 