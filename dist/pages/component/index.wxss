.pageComponent{min-height:100vh;padding-bottom:110rpx;padding-bottom:calc(constant(safe-area-inset-bottom) + 110rpx);padding-bottom:calc(env(safe-area-inset-bottom) + 110rpx);background:#f8f9fa;box-sizing:border-box}.intro{position:relative;overflow:hidden;margin-bottom:8rpx}.introBg{position:absolute;left:0;right:0;top:0;bottom:0;background:radial-gradient(ellipse 80% 90% at 0 0,rgba(202,14,45,.1) 0,transparent 55%),linear-gradient(180deg,#fff 0,#f8f9fa 100%)}.introInner{position:relative;z-index:1;padding:36rpx 40rpx 28rpx}.introTitle{font-size:40rpx;font-weight:700;color:#040a23;letter-spacing:1rpx;line-height:1.3}.introDesc{margin-top:12rpx;font-size:24rpx;line-height:1.5;color:#656979}.tabsSticky{position:sticky;z-index:20;background:#f8f9fa}.tabs{width:100%;padding:8rpx 0 24rpx;box-sizing:border-box;white-space:nowrap}.tabsInner{display:inline-flex;padding:0 32rpx;box-sizing:border-box}.tab{display:inline-flex;align-items:center;flex-shrink:0;height:64rpx;padding:0 28rpx;margin-right:16rpx;background:#fff;border:1rpx solid #e1e5ec;border-radius:32rpx;font-size:26rpx;color:#656979;box-sizing:border-box}.tab:last-child{margin-right:0}.tab:active{opacity:.85}.tabActive{background:#ca0e2d;border-color:#ca0e2d;color:#fff;font-weight:500}.tabActive .tabCount{background:rgba(255,255,255,.22);color:#fff}.tabCount{margin-left:10rpx;padding:0 12rpx;height:32rpx;line-height:32rpx;font-size:20rpx;background:#eff0f5;border-radius:16rpx;color:#9aa0b1}.section{margin:0 32rpx 32rpx}.sectionHead{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx;padding:0 4rpx}.sectionTitleWrap{display:flex;align-items:center;min-width:0;flex:1}.sectionIcon{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:64rpx;height:64rpx;border-radius:16rpx}.sectionMeta{margin-left:16rpx;min-width:0}.sectionTitle{font-size:30rpx;font-weight:700;color:#040a23;line-height:1.3}.sectionDesc{margin-top:4rpx;font-size:22rpx;color:#9aa0b1;line-height:1.4}.sectionCount{flex-shrink:0;margin-left:16rpx;font-size:24rpx;color:#9aa0b1}.list{background:#fff;border:1rpx solid #e1e5ec;border-radius:20rpx;overflow:hidden}.item{display:flex;align-items:center;padding:24rpx 28rpx;border-bottom:1rpx solid #e1e5ec}.item:last-child{border-bottom:none}.item:active{background:#f4f6f7}.itemIcon{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:64rpx;height:64rpx;border-radius:16rpx}.itemLabel{flex:1;margin:0 20rpx;min-width:0;font-size:28rpx;font-weight:500;color:#040a23;line-height:1.3}.safeBottom{height:24rpx}