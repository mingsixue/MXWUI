<view class="pageComponent"><mx-nav title="组件" /><view style="height:{{navHeight}}px;"></view><view class="intro"><view class="introBg"></view><view class="introInner"><view class="introTitle">MXWUI 组件库</view><view class="introDesc">共 {{total}} 个组件，按分类浏览与预览</view></view></view><view class="tabsSticky" style="top: {{navHeight}}px;"><scroll-view class="tabs" scroll-x show-scrollbar="{{false}}"><view class="tabsInner"><view class="tab {{activeKey === item.key ? 'tabActive' : ''}}" wx:for="{{tabs}}" wx:key="key" bind:tap="handleTab" data-key="{{item.key}}" ><text>{{item.name}}</text><text class="tabCount" wx:if="{{item.count}}">{{item.count}}</text></view></view></scroll-view></view><view class="section" id="section-{{cat.key}}" wx:for="{{categories}}" wx:key="key" wx:for-item="cat" ><view class="sectionHead"><view class="sectionTitleWrap"><view class="sectionIcon" style="background: {{cat.bg}};"><mx-icon name="{{cat.icon}}" size="36" color="{{cat.color}}" /></view><view class="sectionMeta"><view class="sectionTitle">{{cat.name}}</view><view class="sectionDesc">{{cat.desc}}</view></view></view><view class="sectionCount">{{cat.list.length}}</view></view><view class="list"><view class="item" wx:for="{{cat.list}}" wx:key="url" wx:for-item="comp" bind:tap="handleGo" data-url="{{comp.url}}" ><view class="itemIcon" style="background: {{cat.bg}};"><mx-icon name="{{comp.icon}}" size="36" color="{{cat.color}}" /></view><view class="itemLabel">{{comp.label}}</view><mx-icon name="arrows_right" size="28" color="#9AA0B1" /></view></view></view><view class="safeBottom"></view><menus current="1" /></view> 