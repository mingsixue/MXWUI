<view class="mx-rate {{readonly ? 'mx-rate-readonly' : ''}}" style="font-size: {{size}}rpx;">
    <view
        class="mx-rate-container"
        catchtouchstart="handleTouchStart"
        catchtouchmove="handleTouchMove"
        catchtouchend="handleTouchEnd"
    >
        <view
            class="mx-rate-star"
            wx:for="{{stars}}"
            wx:key="index"
            style="width: {{size}}rpx; height: {{size}}rpx; margin-right: {{gutter}}rpx;"
        >
            <!-- 未选中底色：character 有值用文本，否则用 icon（默认 collect_checked） -->
            <view class="mx-rate-star-icon mx-rate-star-icon-void" style="color: {{voidColor}};">
                <text wx:if="{{character}}" class="mx-rate-char">{{character}}</text>
                <mx-icon wx:else name="{{icon}}" color="{{voidColor}}" size="{{size}}" />
            </view>
            <!-- 选中覆盖层：外层按比例裁剪，内层固定为整星尺寸，避免半星被压扁 -->
            <view
                class="mx-rate-star-clip"
                style="width: {{item.activeWidth}};"
            >
                <view class="mx-rate-star-icon mx-rate-star-icon-active" style="width: {{size}}rpx; height: {{size}}rpx; color: {{color}};">
                    <text wx:if="{{character}}" class="mx-rate-char">{{character}}</text>
                    <mx-icon wx:else name="{{icon}}" color="{{color}}" size="{{size}}" />
                </view>
            </view>
            <!-- 点击热区 -->
            <view wx:if="{{!readonly}}" class="mx-rate-star-hit">
                <view
                    wx:if="{{allowHalf}}"
                    class="mx-rate-star-hit-half"
                    data-value="{{item.halfValue}}"
                    catch:tap="handleTap"
                />
                <view
                    class="mx-rate-star-hit-full {{allowHalf ? 'mx-rate-star-hit-half-right' : ''}}"
                    data-value="{{item.fullValue}}"
                    catch:tap="handleTap"
                />
            </view>
        </view>
    </view>
</view>
