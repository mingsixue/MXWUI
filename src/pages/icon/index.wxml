<view class="pageIcon">
    <mx-nav title="图标规范" />
    <view style="height:{{navHeight}}px;"></view>

    <view class="intro">
        <view class="introBg"></view>
        <view class="introInner">
            <view class="introTitle">图标规范</view>
            <view class="introDesc">尺寸以 4 的倍数为基准，可自定义颜色与大小</view>
        </view>
    </view>

    <!-- 尺寸阶梯 -->
    <view class="section">
        <view class="sectionHead">
            <view class="sectionTitle">尺寸阶梯</view>
            <view class="sectionDesc">常用图标尺寸对照</view>
        </view>
        <view class="sizeList">
            <view class="sizeItem" wx:for="{{sizes}}" wx:key="value">
                <view class="sizePreview">
                    <mx-icon name="face_smile" size="{{item.value}}" color="#040A23" />
                </view>
                <view class="sizeBody">
                    <view class="sizeValue">{{item.value}}rpx</view>
                    <view class="sizeName">{{item.name}}</view>
                </view>
                <view class="sizeUse">{{item.use}}</view>
            </view>
        </view>
    </view>

    <!-- 使用约定 -->
    <view class="section">
        <view class="sectionHead">
            <view class="sectionTitle">使用约定</view>
            <view class="sectionDesc">颜色与场景建议</view>
        </view>
        <view class="ruleList">
            <view class="ruleItem" wx:for="{{rules}}" wx:key="title">
                <view class="ruleTitle">{{item.title}}</view>
                <view class="ruleDesc">{{item.desc}}</view>
            </view>
        </view>
    </view>

    <!-- 颜色示例 -->
    <view class="section sectionLast">
        <view class="sectionHead">
            <view class="sectionTitle">颜色示例</view>
            <view class="sectionDesc">同一图标在不同语义色下的表现</view>
        </view>
        <view class="colorGrid">
            <view class="colorItem" wx:for="{{colors}}" wx:key="name">
                <view class="colorIcon" style="background: {{item.bg}};">
                    <mx-icon name="{{item.icon}}" size="48" color="{{item.color}}" />
                </view>
                <view class="colorName">{{item.name}}</view>
                <view class="colorValue">{{item.color}}</view>
            </view>
        </view>
    </view>

    <view class="safeBottom"></view>
    <menus current="1" />
</view>
